# Public site origin (used for canonical URLs and sitemap). No trailing slash.
PUBLIC_SITE_URL=https://www.geper.example

# Email shown on the Contact page and used for the mailto fallback.
PUBLIC_CONTACT_EMAIL=contact@geper.in

# Contact form endpoint. Empty = the bundled Cloudflare Worker route (/api/contact).
# Only set this to use a different backend.
PUBLIC_CONTACT_ENDPOINT=

# --- Server-side (Cloudflare Worker, NOT public; never prefix with PUBLIC_) ---
# Set as Worker secrets/variables (dashboard Settings → Variables and Secrets, or `wrangler secret put`). For local `wrangler dev`
# put these in .dev.vars (git-ignored). CONTACT_FROM and CONTACT_TO are configured in wrangler.jsonc.
# Sending from an @geper.in address is rejected by the mail host (554 internal domain use); always send from notify.geper.in.
# RESEND_API_KEY=re_xxxxxxxx          # secret, required
# CONTACT_TO=contact@geper.in         # optional
# CONTACT_FROM=GEPER Website <website@notify.geper.in>

# Optional. URL of an analytics script to include in <head>. Empty = no analytics.
PUBLIC_ANALYTICS_SRC=

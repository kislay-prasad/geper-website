{
  "name": "geper-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run check && npm test && astro build && node scripts/gen-headers.mjs && node scripts/verify-dist.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --no-warnings --test \"test/**/*.test.ts\"",
    "verify": "node scripts/verify-dist.mjs",
    "smoke": "node scripts/smoke.mjs",
    "dev:worker": "npm run build && wrangler dev --port 8787",
    "deploy": "npm run build && wrangler deploy",
    "mock:resend": "node scripts/mock-resend.mjs",
    "start": "node server.mjs"
  },
  "dependencies": {
    "astro": "^7.4.13",
    "gsap": "^3.15.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/three": "^0.180.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.160.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}

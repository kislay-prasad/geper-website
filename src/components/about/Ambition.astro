---
/**
 * Our ambition. The page's largest visual moment: a small cluster that opens
 * into a wide interconnected field as the section is read.
 *
 * Layout is a phyllotaxis spiral, so the field is organic rather than gridded
 * — deliberately unlike the lattice in "Why we exist". Expansion is a single
 * scroll-driven variable: nodes translate outward on a uniform scale about the
 * centre, and the connective lines scale with exactly the same factor, so the
 * two layers stay registered while pixels keep their size.
 *
 * No labels, no direction of flow. It is not a diagram of anything.
 */
import { about } from '@/data/content';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import { rnd, round } from './pixels';

const W = 1120;
const H = 400;
const CX = W / 2;
const CY = H / 2;
const N = 132;
const RX = 520;
const RY = 168;
const GOLDEN = Math.PI * (3 - Math.sqrt(5));
/* How tight the cluster is before it opens. */
const K0 = 0.12;

const nodes = Array.from({ length: N }, (_, i) => {
  const t = (i + 0.5) / N;
  const r = Math.sqrt(t);
  const a = i * GOLDEN;
  /* A little jitter keeps the spiral from reading as a pattern. */
  const x = CX + Math.cos(a) * r * RX + (rnd(i, 31) - 0.5) * 16;
  const y = CY + Math.sin(a) * r * RY + (rnd(i, 32) - 0.5) * 14;
  return {
    i,
    x: round(x, 1),
    y: round(y, 1),
    /* Outer nodes arrive later, so the field grows in complexity. */
    t: round(0.06 + r * 0.62, 3),
    size: rnd(i, 33) < 0.14 ? 4 : rnd(i, 34) < 0.5 ? 3 : 2,
    /* Blue leads, green is the biological accent, amber and coral are
       occasional. Everything else stays neutral, which is most of the field. */
    tone: i < 3 || i % 9 === 4 ? 'signal'
      : i % 16 === 3 ? 'bio'
      : i % 31 === 9 ? 'proc'
      : i % 64 === 21 ? 'mark'
      : '',
  };
});

/* Links between near neighbours only — enough to read as connected, far from
   a complete graph. */
const links: { a: number; b: number; t: number }[] = [];
for (let i = 0; i < N; i++) {
  for (let j = i + 1; j < N; j++) {
    const dx = nodes[i].x - nodes[j].x;
    const dy = nodes[i].y - nodes[j].y;
    if (dx * dx + dy * dy > 76 * 76) continue;
    links.push({ a: i, b: j, t: round(Math.max(nodes[i].t, nodes[j].t) + 0.1, 3) });
  }
}
---
<section class="am relative border-y border-line-faint bg-bg-elevated" aria-labelledby="ambition-title">
  <div class="pointer-events-none absolute inset-0 pattern-dots pattern-fade-y opacity-30" aria-hidden="true"></div>

  <div class="container-page relative pt-14 pb-10 md:pt-16 md:pb-12 lg:pt-20 lg:pb-14">
    <div class="max-w-3xl">
      <Eyebrow>{about.ambition.eyebrow}</Eyebrow>
      <h2 id="ambition-title" class="am-title mt-5 text-h1 text-ink">{about.ambition.title}</h2>
    </div>

    <div class="mt-7 flex max-w-prose flex-col gap-4">
      {about.ambition.paragraphs.map((p, i) => (
        <p class="am-p text-body text-ink-2" style={`--d:${(0.12 + i * 0.1).toFixed(2)}s`}>{p}</p>
      ))}
    </div>

    <svg class="am-field mt-8" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice" role="img" aria-label="A small cluster of points expanding into a wide, interconnected field.">
      <g class="am-links">
        {links.map((l) => (
          <line
            class="am-link"
            x1={nodes[l.a].x}
            y1={nodes[l.a].y}
            x2={nodes[l.b].x}
            y2={nodes[l.b].y}
            vector-effect="non-scaling-stroke"
            style={`--t:${l.t}`}
          />
        ))}
      </g>
      <g>
        {nodes.map((n) => (
          <rect
            class:list={['am-node', n.tone && `is-${n.tone}`]}
            x={n.x - n.size / 2}
            y={n.y - n.size / 2}
            width={n.size}
            height={n.size}
            style={`--bx:${round((CX - n.x) * (1 - K0), 1)}px;--by:${round((CY - n.y) * (1 - K0), 1)}px;--t:${n.t}`}
          />
        ))}
      </g>
    </svg>
  </div>
</section>

<script>
  const sec = document.querySelector<HTMLElement>('.am');
  if (sec) {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      sec.style.setProperty('--e', '1');
      sec.classList.add('is-in');
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            sec.classList.add('is-in');
            io.disconnect();
          }
        },
        { rootMargin: '0px 0px -12% 0px' },
      );
      io.observe(sec);

      const field = sec.querySelector<HTMLElement>('.am-field');
      let queued = false;
      const update = () => {
        queued = false;
        if (!field) return;
        const r = field.getBoundingClientRect();
        if (r.bottom < -300 || r.top > innerHeight + 300) return;
        /* Driven by the field's own centre: a cluster as it enters from the
           bottom, fully open by the time it sits in the middle of the screen. */
        const centre = r.top + r.height / 2;
        const raw = Math.min(1, Math.max(0, (innerHeight * 1.05 - centre) / (innerHeight * 0.5)));
        const e = raw * raw * (3 - 2 * raw);
        sec.style.setProperty('--e', e.toFixed(4));
      };
      const onScroll = () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(update);
      };
      addEventListener('scroll', onScroll, { passive: true });
      addEventListener('resize', onScroll, { passive: true });
      update();
    }
  }
</script>

<style>
  .am {
    --e: 0;
    /* The uniform factor both layers expand by. */
    --k: calc(0.12 + 0.88 * var(--e));
  }

  /* On a narrow screen the full width would render each pixel at about one
     device pixel, so the frame gets taller and crops to the centre of the
     field instead — the same system, seen closer. */
  .am-field {
    width: 100%;
    aspect-ratio: 1120 / 400;
    overflow: hidden;
  }
  @media (max-width: 767px) {
    .am-field { aspect-ratio: 5 / 4; }
  }

  .am-node {
    fill: var(--color-fig-mid);
    transform: translate(calc(var(--bx) * (1 - var(--e))), calc(var(--by) * (1 - var(--e))));
    opacity: min(0.72, calc((var(--e) - var(--t)) * 2.4));
  }
  /* Active nodes sit a little stronger than the field, with a halo small
     enough to read as emphasis rather than glow. */
  .am-node.is-signal,
  .am-node.is-bio,
  .am-node.is-proc,
  .am-node.is-mark {
    opacity: min(0.92, calc((var(--e) - var(--t)) * 2.6));
    filter: drop-shadow(0 0 2px color-mix(in srgb, currentColor 35%, transparent));
  }
  .am-node.is-signal { fill: var(--color-sci-blue); color: var(--color-sci-blue); }
  .am-node.is-bio { fill: var(--color-sci-green); color: var(--color-sci-green); }
  .am-node.is-proc { fill: var(--color-sci-amber); color: var(--color-sci-amber); }
  .am-node.is-mark { fill: var(--color-sci-coral); color: var(--color-sci-coral); }

  /* Scaling about (CX, CY) written out, so it matches the node translate
     exactly without depending on transform-origin resolution. */
  .am-links {
    transform: translate(calc(560px * (1 - var(--k))), calc(200px * (1 - var(--k)))) scale(var(--k));
  }
  .am-link {
    stroke: var(--color-fig-line);
    stroke-width: 1;
    opacity: min(0.26, calc((var(--e) - var(--t)) * 1.1));
  }

  .am-title,
  .am-p {
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 700ms var(--ease-out-quart), transform 700ms var(--ease-out-quart);
    transition-delay: var(--d, 0s);
  }
  .am.is-in .am-title,
  .am.is-in .am-p { opacity: 1; transform: none; }

  @media (prefers-reduced-motion: reduce) {
    .am-title, .am-p { opacity: 1; transform: none; transition: none; }
    .am-node { transform: none; }
  }
</style>

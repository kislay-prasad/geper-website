---
/**
 * Why we exist. An editorial statement, a short supporting paragraph, and a
 * pixel field that gathers as the section is read.
 *
 * The field is metaphor, not diagram: scattered material finding an order.
 * Each pixel carries its own scatter offset and is pulled toward a lattice
 * position by a single scroll-driven variable, so the whole system resolves
 * with the reader rather than on a timer. Once gathered it keeps breathing
 * outward very slightly — coherence, not conclusion.
 */
import { about } from '@/data/content';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import { rnd, srnd, round } from './pixels';

const COLS = 13;
const ROWS = 11;
const PITCH = 20;
const W = 340;
const H = 260;
const originX = (W - (COLS - 1) * PITCH) / 2;
const originY = (H - (ROWS - 1) * PITCH) / 2;

/* The gathered form is a disc, not a grid: cells outside the radius are
   dropped, and brightness falls off toward the edge — so what resolves reads
   as one structure rather than as background texture. */
type Cell = {
  x: number; y: number; sx: number; sy: number; size: number;
  core: boolean; tone: '' | 'signal' | 'bio' | 'proc' | 'mark';
  op: number; dur: number; delay: number;
};
const cells: Cell[] = [];
for (let r = 0; r < ROWS; r++) {
  for (let c = 0; c < COLS; c++) {
    const i = r * COLS + c;
    const nx = (c - (COLS - 1) / 2) / ((COLS - 1) / 2);
    const ny = (r - (ROWS - 1) / 2) / ((ROWS - 1) / 2);
    const rad = Math.hypot(nx, ny);
    /* A soft edge: cells near the rim thin out instead of stopping dead. */
    if (rad > 1.02) continue;
    if (rad > 0.72 && rnd(i, 11) < (rad - 0.72) * 2.2) continue;
    cells.push({
      x: originX + c * PITCH,
      y: originY + r * PITCH,
      /* Where the pixel sits before it is gathered. */
      sx: round(srnd(i, 12) * 150),
      sy: round(srnd(i, 13) * 120),
      size: rad < 0.3 ? 4 : rad < 0.75 ? 3 : 2,
      core: rad < 0.26,
      /* Most points stay neutral. A small share take a hue, weighted so blue
         leads, green follows, amber is occasional and coral is rare. */
      tone: rad < 0.26 || i % 11 === 0 ? 'signal'
        : i % 17 === 5 ? 'bio'
        : i % 29 === 7 ? 'proc'
        : i % 61 === 13 ? 'mark'
        : '',
      op: round(0.9 - rad * 0.45, 2),
      /* Twinkle keeps the scattered state alive before any scrolling. */
      dur: round(6 + rnd(i, 15) * 7, 1),
      delay: round(rnd(i, 16) * -12, 1),
    });
  }
}
---
<section class="wwe relative border-y border-line-faint bg-bg-elevated" aria-labelledby="why-title">
  <div class="container-page relative py-14 md:py-16 lg:py-20">
    <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-7">
        <Eyebrow>{about.why.eyebrow}</Eyebrow>
        <h2 id="why-title" class="wwe-statement mt-5 max-w-2xl text-h1 text-ink">{about.why.statement}</h2>
        <div class="mt-6 flex max-w-prose flex-col gap-4">
          {about.why.paragraphs.map((p, i) => (
            <p class="wwe-p text-body text-ink-2" style={`--d:${(0.1 + i * 0.1).toFixed(2)}s`}>{p}</p>
          ))}
        </div>
      </div>

      <div class="lg:col-span-5">
        <svg class="wwe-field" viewBox={`0 0 ${W} ${H}`} role="img" aria-label="A scattered field of points gathering into an ordered lattice.">
          <g class="wwe-g">
            {cells.map((c) => (
              <rect
                class:list={['wwe-px', c.tone && `is-${c.tone}`]}
                x={c.x - c.size / 2}
                y={c.y - c.size / 2}
                width={c.size}
                height={c.size}
                style={`--sx:${c.sx}px;--sy:${c.sy}px;--o:${c.op};--dur:${c.dur}s;--delay:${c.delay}s`}
              />
            ))}
          </g>
        </svg>
      </div>
    </div>
  </div>
</section>

<script>
  const sec = document.querySelector<HTMLElement>('.wwe');
  if (sec) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) {
      sec.style.setProperty('--g', '1');
      sec.classList.add('is-in');
    } else {
      /* Reveal the copy once, then let scroll drive the gathering. */
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            sec.classList.add('is-in');
            io.disconnect();
          }
        },
        { rootMargin: '0px 0px -12% 0px' },
      );
      io.observe(sec);

      let queued = false;
      const update = () => {
        queued = false;
        const r = sec.getBoundingClientRect();
        if (r.bottom < -200 || r.top > innerHeight + 200) return;
        /* Scattered as the section enters, fully gathered by the time it is
           roughly centred — so the resolved state is what gets read. */
        const travelled = innerHeight * 0.9 - r.top;
        const raw = Math.min(1, Math.max(0, travelled / (innerHeight * 0.55)));
        /* Smoothstep: no visible start or stop to the gathering. */
        const g = raw * raw * (3 - 2 * raw);
        sec.style.setProperty('--g', g.toFixed(4));
      };
      const onScroll = () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(update);
      };
      addEventListener('scroll', onScroll, { passive: true });
      addEventListener('resize', onScroll, { passive: true });
      update();
    }
  }
</script>

<style>
  .wwe { --g: 0; }

  .wwe-field {
    width: 100%;
    max-width: 29rem;
    aspect-ratio: 340 / 260;
    overflow: visible;
  }
  @media (max-width: 1023px) {
    .wwe-field { max-width: 24rem; }
  }

  /* The gathered structure keeps expanding, very slowly. */
  .wwe-g {
    transform-origin: 50% 50%;
    transform-box: fill-box;
    animation: wwe-expand 24s ease-in-out infinite;
  }
  @keyframes wwe-expand {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.035); }
  }

  .wwe-px {
    fill: var(--color-fig-mid);
    /* (1 - g) leaves the pixel at its scatter offset; g pulls it home. */
    transform: translate(calc(var(--sx) * (1 - var(--g))), calc(var(--sy) * (1 - var(--g))));
    /* Scattered pixels are uniformly dim; the radial falloff only arrives as
       the structure does, which is what makes it read as one object. */
    opacity: calc(0.26 + var(--g) * var(--o) * 0.7);
    animation: wwe-twinkle var(--dur) ease-in-out infinite;
    animation-delay: var(--delay);
  }
  /* Hues, not a colour wash: the neutral fill above still carries the field. */
  .wwe-px.is-signal { fill: var(--color-sci-blue); }
  .wwe-px.is-bio { fill: var(--color-sci-green); }
  .wwe-px.is-proc { fill: var(--color-sci-amber); }
  .wwe-px.is-mark { fill: var(--color-sci-coral); }

  @keyframes wwe-twinkle {
    0%, 100% { fill-opacity: 0.55; }
    50% { fill-opacity: 1; }
  }
  .wwe-px.is-signal,
  .wwe-px.is-bio,
  .wwe-px.is-proc,
  .wwe-px.is-mark { opacity: calc(0.32 + var(--g) * var(--o) * 0.72); }

  .wwe-statement,
  .wwe-p {
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 700ms var(--ease-out-quart), transform 700ms var(--ease-out-quart);
    transition-delay: var(--d, 0s);
  }
  .wwe.is-in .wwe-statement,
  .wwe.is-in .wwe-p { opacity: 1; transform: none; }

  @media (prefers-reduced-motion: reduce) {
    .wwe-g { animation: none; }
    .wwe-px { animation: none; transform: none; }
    .wwe-statement, .wwe-p { opacity: 1; transform: none; transition: none; }
  }
</style>

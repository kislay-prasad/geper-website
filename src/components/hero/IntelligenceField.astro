---
/**
 * Hero visual: biological signal flow through GEPER
 *
 * Prioritizes the actual message: biological data enters the system,
 * is processed by GEPER, and emerges as coherent biologic insight.
 */
---
<div class="intelligence-field" aria-label="Biological data flows through GEPER into insight">
  <svg viewBox="0 0 760 520" class="intelligence-field__svg" role="img" aria-labelledby="field-title field-desc">
    <title id="field-title">GEPER biological data processing</title>
    <desc id="field-desc">Different biological data streams flow into a central GEPER layer and emerge as organized biological insight.</desc>

    <defs>
      <linearGradient id="panelGlow" x1="0%" x2="100%" y1="0%" y2="100%">
        <stop offset="0%" stop-color="#0c1b32" stop-opacity="0.92" />
        <stop offset="50%" stop-color="#0d1828" stop-opacity="0.88" />
        <stop offset="100%" stop-color="#09141f" stop-opacity="0.94" />
      </linearGradient>

      <linearGradient id="coreStroke" x1="0%" x2="100%" y1="0%" y2="100%">
        <stop offset="0%" stop-color="#72a6d8" />
        <stop offset="45%" stop-color="#6bd3d6" />
        <stop offset="100%" stop-color="#a6c9ef" />
      </linearGradient>

      <linearGradient id="signalA" x1="0%" x2="100%" y1="0%" y2="0%">
        <stop offset="0%" stop-color="#7aa0d5" stop-opacity="0.1" />
        <stop offset="25%" stop-color="#7aa0d5" stop-opacity="0.9" />
        <stop offset="75%" stop-color="#7aa0d5" stop-opacity="0.8" />
        <stop offset="100%" stop-color="#7aa0d5" stop-opacity="0.1" />
      </linearGradient>

      <linearGradient id="signalB" x1="0%" x2="100%" y1="0%" y2="0%">
        <stop offset="0%" stop-color="#6ecab4" stop-opacity="0.1" />
        <stop offset="30%" stop-color="#6ecab4" stop-opacity="0.8" />
        <stop offset="75%" stop-color="#6ecab4" stop-opacity="0.8" />
        <stop offset="100%" stop-color="#6ecab4" stop-opacity="0.1" />
      </linearGradient>

      <linearGradient id="signalC" x1="0%" x2="100%" y1="0%" y2="0%">
        <stop offset="0%" stop-color="#d7b765" stop-opacity="0.12" />
        <stop offset="35%" stop-color="#d7b765" stop-opacity="0.8" />
        <stop offset="75%" stop-color="#d7b765" stop-opacity="0.8" />
        <stop offset="100%" stop-color="#d7b765" stop-opacity="0.12" />
      </linearGradient>

      <linearGradient id="signalD" x1="0%" x2="100%" y1="0%" y2="0%">
        <stop offset="0%" stop-color="#ca7d63" stop-opacity="0.12" />
        <stop offset="35%" stop-color="#ca7d63" stop-opacity="0.8" />
        <stop offset="75%" stop-color="#ca7d63" stop-opacity="0.75" />
        <stop offset="100%" stop-color="#ca7d63" stop-opacity="0.12" />
      </linearGradient>

      <linearGradient id="outputGlow" x1="0%" x2="100%" y1="0%" y2="0%">
        <stop offset="0%" stop-color="#bdd8ff" stop-opacity="0.2" />
        <stop offset="50%" stop-color="#6acdcb" stop-opacity="0.8" />
        <stop offset="100%" stop-color="#d4d69a" stop-opacity="0.2" />
      </linearGradient>

      <pattern id="gridTiny" width="18" height="18" patternUnits="userSpaceOnUse">
        <path d="M 18 0 L 0 0 0 18" fill="none" stroke="rgba(158,180,214,0.08)" stroke-width="0.6" />
      </pattern>
    </defs>

    <g class="scene-shell">
      <rect x="10" y="18" width="740" height="484" rx="28" fill="url(#panelGlow)" opacity="0.24" />
      <rect x="16" y="24" width="728" height="472" rx="24" fill="url(#gridTiny)" opacity="0.52" />
      <rect x="16" y="24" width="728" height="472" rx="24" fill="none" stroke="rgba(161,177,207,0.18)" stroke-width="1" />
    </g>

    <g class="input-group">
      <g class="input-panel input-panel--genomic">
        <text x="58" y="72" class="input-label" fill="#8ea7d1">GENOMIC</text>
        <g class="sequence-stack" transform="translate(55 95)">
          <path class="sequence-line" d="M 0 0 H 120 M 0 24 H 120 M 0 48 H 120 M 0 72 H 120" />
          <g class="sequence-cells">
            <rect x="8" y="-6" width="12" height="12" rx="3" />
            <rect x="26" y="18" width="12" height="12" rx="3" />
            <rect x="54" y="42" width="12" height="12" rx="3" />
            <rect x="74" y="66" width="12" height="12" rx="3" />
            <rect x="96" y="-6" width="12" height="12" rx="3" />
            <rect x="112" y="18" width="12" height="12" rx="3" />
          </g>
        </g>
      </g>

      <g class="input-panel input-panel--structure">
        <text x="70" y="238" class="input-label" fill="#7ec8ba">STRUCTURE</text>
        <g transform="translate(60 260)">
          <circle class="structure-node" cx="20" cy="20" r="12" />
          <circle class="structure-node" cx="58" cy="20" r="12" />
          <circle class="structure-node" cx="96" cy="20" r="12" />
          <path class="structure-link" d="M 32 20 H 46 M 70 20 H 84" />
          <path class="structure-link" d="M 46 6 L 58 20 L 46 34" />
          <path class="structure-link" d="M 70 6 L 58 20 L 70 34" />
        </g>
      </g>

      <g class="input-panel input-panel--expression">
        <text x="62" y="350" class="input-label" fill="#d7b765">EXPRESSION</text>
        <g transform="translate(56 366)">
          <path class="trace-line" d="M 0 12 C 25 4, 40 18, 68 12 S 106 8, 143 13" />
          <path class="trace-line trace-line--alt" d="M 0 42 C 28 52, 40 30, 68 32 S 110 44, 143 36" />
          <path class="trace-line trace-line--subtle" d="M 0 64 C 24 70, 44 48, 68 52 S 110 66, 143 60" />
          <circle class="signal-marker" cx="42" cy="14" r="4" />
          <circle class="signal-marker" cx="95" cy="34" r="4" />
          <circle class="signal-marker" cx="122" cy="60" r="4" />
        </g>
      </g>

      <g class="input-panel input-panel--context">
        <text x="60" y="470" class="input-label" fill="#cc8e6e">CONTEXT</text>
        <g transform="translate(62 485)">
          <circle class="cluster-node" cx="12" cy="22" r="7" />
          <circle class="cluster-node" cx="34" cy="12" r="7" />
          <circle class="cluster-node" cx="54" cy="24" r="7" />
          <circle class="cluster-node" cx="75" cy="10" r="7" />
          <circle class="cluster-node" cx="100" cy="24" r="7" />
          <circle class="cluster-node" cx="118" cy="12" r="7" />
          <path class="cluster-link" d="M 12 22 L 34 12 L 54 24 L 75 10 L 100 24 L 118 12" />
        </g>
      </g>
    </g>

    <g class="flow-group">
      <path id="flow-a" class="flow-path flow-path--a" d="M 222 110 C 255 138, 284 152, 312 181" />
      <path id="flow-b" class="flow-path flow-path--b" d="M 220 218 C 260 224, 286 220, 308 214" />
      <path id="flow-c" class="flow-path flow-path--c" d="M 224 332 C 255 305, 285 290, 310 248" />
      <path id="flow-d" class="flow-path flow-path--d" d="M 228 440 C 262 392, 288 318, 315 260" />

      <circle r="4" fill="#7aa0d5" class="flow-dot flow-dot--a">
        <animateMotion dur="5.2s" repeatCount="indefinite" rotate="auto">
          <mpath href="#flow-a" />
        </animateMotion>
      </circle>
      <circle r="4" fill="#6ecab4" class="flow-dot flow-dot--b">
        <animateMotion dur="5.7s" begin="-1.3s" repeatCount="indefinite" rotate="auto">
          <mpath href="#flow-b" />
        </animateMotion>
      </circle>
      <circle r="4" fill="#d7b765" class="flow-dot flow-dot--c">
        <animateMotion dur="6.4s" begin="-2.5s" repeatCount="indefinite" rotate="auto">
          <mpath href="#flow-c" />
        </animateMotion>
      </circle>
      <circle r="4" fill="#ca7d63" class="flow-dot flow-dot--d">
        <animateMotion dur="6.1s" begin="-0.7s" repeatCount="indefinite" rotate="auto">
          <mpath href="#flow-d" />
        </animateMotion>
      </circle>
    </g>

    <g class="core-group">
      <circle class="core-glow" cx="382" cy="250" r="128" fill="rgba(109, 162, 222, 0.08)" />
      <rect class="core-shell" x="285" y="120" width="200" height="260" rx="30" fill="rgba(9, 15, 22, 0.55)" stroke="url(#coreStroke)" stroke-width="1.4" />
      <rect class="core-inner" x="312" y="146" width="146" height="208" rx="22" fill="rgba(12, 24, 38, 0.62)" stroke="rgba(164,195,236,0.18)" />

      <g class="core-grid" opacity="0.84">
        <path d="M 330 185 H 448 M 330 250 H 448 M 330 315 H 448 M 368 165 V 336 M 382 165 V 336 M 396 165 V 336 M 410 165 V 336" />
        <circle cx="382" cy="250" r="52" fill="none" stroke="rgba(110,180,214,0.4)" stroke-width="1.2" />
        <circle cx="382" cy="250" r="34" fill="none" stroke="rgba(110,180,214,0.26)" stroke-width="1" />
      </g>

      <g class="core-logic" opacity="0.88">
        <path d="M 330 212 C 355 198, 365 198, 382 212 S 410 226, 448 214" />
        <path d="M 332 288 C 355 302, 368 302, 382 288 S 410 274, 448 286" />
        <path d="M 344 180 V 320 M 420 180 V 320" />
        <circle cx="382" cy="250" r="9" fill="#9ecdf3" />
      </g>

      <text x="382" y="382" text-anchor="middle" class="core-label">GEPER</text>
    </g>

    <g class="output-group">
      <path id="output-a" class="output-path output-path--a" d="M 485 174 C 552 180, 585 186, 620 214" />
      <path id="output-b" class="output-path output-path--b" d="M 486 250 C 562 240, 592 246, 628 250" />
      <path id="output-c" class="output-path output-path--c" d="M 484 326 C 558 328, 588 312, 628 290" />

      <g class="output-pattern output-pattern--a" transform="translate(620 204)">
        <path d="M 0 0 C 26 -12, 36 -12, 62 0 M 0 22 C 26 34, 36 34, 62 22" />
        <circle cx="18" cy="10" r="5" />
        <circle cx="44" cy="12" r="5" />
      </g>

      <g class="output-pattern output-pattern--b" transform="translate(628 238)">
        <path d="M 0 0 C 24 -18, 34 -18, 58 0 M 0 18 C 24 34, 34 34, 58 18" />
        <circle cx="18" cy="10" r="5" />
        <circle cx="42" cy="10" r="5" />
      </g>

      <g class="output-pattern output-pattern--c" transform="translate(620 276)">
        <path d="M 0 0 C 22 -14, 38 -14, 62 0 M 0 20 C 22 34, 38 34, 62 20" />
        <circle cx="20" cy="10" r="5" />
        <circle cx="46" cy="11" r="5" />
      </g>

      <circle r="5" fill="#7aa0d5" class="output-dot output-dot--a">
        <animateMotion dur="5.8s" repeatCount="indefinite" rotate="auto">
          <mpath href="#output-a" />
        </animateMotion>
      </circle>
      <circle r="5" fill="#6ecab4" class="output-dot output-dot--b">
        <animateMotion dur="5.9s" begin="-1.1s" repeatCount="indefinite" rotate="auto">
          <mpath href="#output-b" />
        </animateMotion>
      </circle>
      <circle r="5" fill="#d7b765" class="output-dot output-dot--c">
        <animateMotion dur="6.5s" begin="-2.3s" repeatCount="indefinite" rotate="auto">
          <mpath href="#output-c" />
        </animateMotion>
      </circle>
    </g>
  </svg>
</div>

<style>
  .intelligence-field {
    width: 100%;
    max-width: 760px;
    margin-inline: auto;
  }

  .intelligence-field__svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .input-label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-family: var(--font-mono);
    opacity: 0.86;
  }

  .sequence-line,
  .trace-line,
  .structure-link,
  .cluster-link,
  .flow-path,
  .output-path,
  .core-grid path,
  .core-logic path {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .sequence-line,
  .trace-line,
  .structure-link,
  .cluster-link,
  .core-grid path,
  .core-logic path {
    stroke: rgba(160, 187, 224, 0.34);
    stroke-width: 1.1;
  }

  .sequence-cells rect,
  .structure-node,
  .signal-marker,
  .cluster-node,
  .output-pattern circle,
  .output-pattern path,
  .core-logic circle {
    vector-effect: non-scaling-stroke;
  }

  .sequence-cells rect,
  .structure-node,
  .cluster-node,
  .signal-marker {
    fill: rgba(150, 172, 216, 0.06);
    stroke: rgba(166, 197, 238, 0.5);
    stroke-width: 0.8;
  }

  .sequence-cells rect:nth-child(1),
  .sequence-cells rect:nth-child(3),
  .sequence-cells rect:nth-child(5) {
    fill: rgba(122, 160, 213, 0.18);
  }

  .sequence-cells rect:nth-child(2),
  .sequence-cells rect:nth-child(4),
  .sequence-cells rect:nth-child(6) {
    fill: rgba(108, 205, 168, 0.16);
  }

  .structure-node {
    fill: rgba(124, 214, 204, 0.1);
  }

  .trace-line {
    stroke: rgba(215, 183, 101, 0.7);
    stroke-width: 1.4;
  }

  .trace-line--alt {
    stroke: rgba(110, 202, 180, 0.72);
  }

  .trace-line--subtle {
    stroke: rgba(202, 125, 99, 0.52);
  }

  .signal-marker {
    fill: rgba(215, 183, 101, 0.88);
    stroke: rgba(245, 217, 141, 0.8);
  }

  .cluster-node {
    fill: rgba(211, 143, 105, 0.1);
    stroke: rgba(218, 149, 110, 0.54);
  }

  .cluster-link,
  .structure-link {
    stroke: rgba(166, 204, 217, 0.44);
  }

  .flow-path {
    stroke-width: 1.2;
    stroke-dasharray: 26 18;
    opacity: 0.7;
    animation: flowPulse 7s linear infinite;
  }

  .flow-path--a { stroke: url(#signalA); }
  .flow-path--b { stroke: url(#signalB); }
  .flow-path--c { stroke: url(#signalC); }
  .flow-path--d { stroke: url(#signalD); }

  .flow-dot {
    filter: drop-shadow(0 0 6px rgba(101, 165, 222, 0.7));
    opacity: 0.95;
  }

  .core-glow {
    animation: coreGlow 4s ease-in-out infinite;
  }

  .core-shell {
    box-shadow: 0 0 18px rgba(94, 152, 219, 0.2);
  }

  .core-inner {
    animation: platformShift 6s ease-in-out infinite;
  }

  .core-grid {
    animation: coreGrid 4.5s ease-in-out infinite;
  }

  .core-logic path {
    stroke: rgba(163, 214, 255, 0.7);
    stroke-width: 1.1;
  }

  .core-logic circle {
    fill: rgba(159, 206, 255, 0.9);
    stroke: rgba(219, 234, 255, 0.6);
    stroke-width: 0.8;
  }

  .core-label {
    fill: #d3e5ff;
    font-size: 12px;
    font-family: var(--font-mono);
    letter-spacing: 0.28em;
    opacity: 0.9;
    animation: labelFloat 4s ease-in-out infinite;
  }

  .output-path {
    stroke-width: 1.2;
    stroke-dasharray: 22 14;
    opacity: 0.8;
    animation: outputFlow 6s linear infinite;
  }

  .output-path--a { stroke: url(#signalA); }
  .output-path--b { stroke: url(#signalB); }
  .output-path--c { stroke: url(#signalC); }

  .output-pattern path {
    fill: none;
    stroke: rgba(198, 229, 255, 0.68);
    stroke-width: 1.2;
  }

  .output-pattern circle {
    fill: rgba(165, 236, 223, 0.9);
    stroke: rgba(225, 243, 255, 0.8);
    stroke-width: 0.8;
  }

  .output-dot {
    filter: drop-shadow(0 0 8px rgba(110, 202, 180, 0.7));
  }

  @keyframes flowPulse {
    0% {
      stroke-dashoffset: 240;
      opacity: 0.1;
    }
    20% {
      opacity: 0.8;
    }
    100% {
      stroke-dashoffset: 0;
      opacity: 0.35;
    }
  }

  @keyframes coreGlow {
    0%, 100% {
      opacity: 0.2;
      transform: scale(0.98);
    }
    50% {
      opacity: 0.38;
      transform: scale(1.04);
    }
  }

  @keyframes platformShift {
    0%, 100% {
      opacity: 0.7;
      transform: scale(0.98);
    }
    50% {
      opacity: 1;
      transform: scale(1.02);
    }
  }

  @keyframes coreGrid {
    0%, 100% {
      opacity: 0.7;
    }
    50% {
      opacity: 1;
    }
  }

  @keyframes outputFlow {
    0% {
      stroke-dashoffset: 220;
      opacity: 0.15;
    }
    25% {
      opacity: 0.8;
    }
    100% {
      stroke-dashoffset: 0;
      opacity: 0.3;
    }
  }

  @keyframes labelFloat {
    0%, 100% {
      opacity: 0.76;
    }
    50% {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flow-path,
    .core-glow,
    .core-inner,
    .core-grid,
    .output-path,
    .core-label {
      animation: none !important;
    }
  }
</style>

<script type="module">
  import { gsap } from 'gsap';

  const field = document.querySelector('.intelligence-field');
  if (field) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    if (!reducedMotion.matches) {
      gsap.set(field, { opacity: 0, scale: 0.94, y: 8 });
      gsap.to(field, { opacity: 1, scale: 1, y: 0, duration: 1.15, ease: 'power2.out', delay: 0.18 });
    } else {
      field.style.opacity = '1';
    }
  }
</script>

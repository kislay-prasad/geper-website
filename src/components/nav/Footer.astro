---
import { footerColumns, site, socials } from '@/data/site';
import Icon from '@/components/ui/Icon.astro';
---
<footer class="bg-bg">
  <div class="container-page py-5 md:py-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between md:gap-10">
      <a href="/" class="inline-flex items-center gap-3 rounded-sm" aria-label={`${site.name} — home`}>
        <img src="/brand/geper-mark-160.png" srcset="/brand/geper-mark-160.png 1x, /brand/geper-mark-320.png 2x" width="50" height="32" alt="" class="h-9 w-auto sm:h-10" />
        <span class="text-h3 tracking-tight text-ink">{site.name}</span>
      </a>

      <!-- One line on desktop: label then its links, groups set apart by space
           alone. Wraps only when the viewport cannot hold the row. -->
      <nav aria-label="Footer" class="flex flex-wrap items-center gap-x-8 gap-y-3 md:gap-x-11">
        {footerColumns.map((col) => (
          <div class="flex items-center gap-3 sm:gap-3.5">
            <span class="label text-accent">{col.heading.toUpperCase()}</span>
            {col.links.map((l) => (
              <a href={l.href} class="text-body-sm text-ink-2 transition-colors duration-150 hover:text-accent">{l.label}</a>
            ))}
          </div>
        ))}
      </nav>
    </div>

    <!-- The social links share the copyright row rather than taking one of
         their own, so the footer keeps its existing height, rhythm and the
         SYSTEM / COMPANY / LEGAL line above it exactly as they were. -->
    <div class="mt-4 flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
      <p class="text-meta text-ink-muted">
        © {site.copyrightYear} {site.legalName}
      </p>

      <ul class="-mr-2 flex items-center">
        {socials.map((s) => (
          <li>
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={s.label}
              class="inline-flex h-9 w-9 items-center justify-center rounded-sm text-ink-muted transition-colors duration-150 hover:text-accent"
            >
              <Icon name={s.icon} size={17} />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</footer>

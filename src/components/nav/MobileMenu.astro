---
/**
 * Mobile navigation. Progressive enhancement over <details>: links are
 * reachable without JavaScript; the script adds focus trapping, Escape,
 * scroll lock and focus return.
 */
import { nav } from '@/data/site';
import Icon from '@/components/ui/Icon.astro';
interface Props { current: string }
const { current } = Astro.props;
---
<details id="mobile-menu" class="group lg:hidden">
  <summary
    class="flex min-h-11 min-w-11 cursor-pointer list-none items-center justify-center gap-2 rounded-md border border-line-strong px-3 text-body-sm text-ink [&::-webkit-details-marker]:hidden"
    aria-label="Open menu"
    aria-controls="mobile-menu-panel"
  >
    <span class="group-open:hidden"><Icon name="menu" size={20} /></span>
    <span class="hidden group-open:block"><Icon name="close" size={20} /></span>
    <span class="label">Menu</span>
  </summary>

  <div id="mobile-menu-panel" class="fixed inset-x-0 top-16 bottom-0 z-40 overflow-y-auto border-t border-line-faint bg-bg" role="dialog" aria-label="Site navigation" aria-modal="true">
    <nav aria-label="Primary (mobile)" class="container-page py-6">
      <ul class="flex flex-col divide-y divide-line-faint">
        <li>
          <a href="/" aria-current={current === '/' ? 'page' : undefined} class={`flex min-h-14 items-center text-h3 ${current === '/' ? 'text-accent-text' : 'text-ink'}`}>Home</a>
        </li>
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={current === item.href ? 'page' : undefined} class={`flex min-h-14 items-center text-h3 ${current === item.href ? 'text-accent-text' : 'text-ink'}`}>{item.label}</a>
          </li>
        ))}
      </ul>
      <p class="label mt-8 text-ink-muted">Computational genomics · Chennai, India</p>
    </nav>
  </div>
</details>

<script>
  const details = document.getElementById('mobile-menu') as HTMLDetailsElement | null;
  if (details) {
    const summary = details.querySelector('summary') as HTMLElement;
    const panel = details.querySelector('#mobile-menu-panel') as HTMLElement;
    const focusable = () => Array.from(panel.querySelectorAll<HTMLElement>('a[href], button, [tabindex]:not([tabindex="-1"])'));
    const sync = () => {
      const open = details.open;
      summary.setAttribute('aria-expanded', String(open));
      summary.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      document.documentElement.classList.toggle('overflow-hidden', open);
      if (open) focusable()[0]?.focus();
    };
    summary.setAttribute('aria-expanded', 'false');
    details.addEventListener('toggle', sync);
    document.addEventListener('keydown', (e) => {
      if (!details.open) return;
      if (e.key === 'Escape') { details.open = false; summary.focus(); return; }
      if (e.key === 'Tab') {
        const items = [summary, ...focusable()];
        const first = items[0], last = items[items.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
      }
    });
    // Close when resized to desktop so scroll lock never sticks.
    const mq = window.matchMedia('(min-width: 1024px)');
    mq.addEventListener('change', () => { if (mq.matches && details.open) details.open = false; });
  }
</script>

---
/**
 * The one availability line, held in a plain frame. No motif, no motion: it
 * states the status and gets out of the way.
 */
import { platform } from '@/data/content';
---
<div class="ac">
  <p class="ac-text text-body-sm text-ink-2">{platform.product.availabilityNote}</p>
</div>

<style>
  /* The frame hugs the sentence: fit-content on both axes, with the wrap
     balanced so neither line is left short. */
  .ac {
    display: inline-block;
    width: fit-content;
    max-width: min(22rem, 100%);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--color-fig-bright) 3%, transparent);
    padding: 0.5rem 0.75rem;
  }

  .ac-text {
    line-height: 1.45;
    text-wrap: balance;
  }
</style>

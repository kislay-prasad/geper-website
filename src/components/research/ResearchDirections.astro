---
/**
 * Four research directions as a selector, not as four blocks of prose.
 *
 * The list on the left drives one diagram panel on the right. Pointer, focus
 * and click all set the active direction; when the pointer is elsewhere, the
 * direction nearest the middle of the viewport takes over, so the panel also
 * follows a plain scroll.
 */
import { research } from '@/data/content';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import StatusBadge from '@/components/ui/StatusBadge.astro';
const pillars = research.pillars;

/* Purely presentational: what the diagram beside each direction is showing. */
const captions = [
  'encoding that preserves context',
  'modalities combined',
  'evidence, carrying provenance',
  'proposed — not established',
];

const seqBars = Array.from({ length: 19 }, (_, j) => ({ j, x: 30 + j * 14 }));
const encBlocks = [26, 84, 142, 200, 258];
/* One muted hue per modality — the only place in this section where colour
   distinguishes rather than decorates. They resolve into one neutral stack. */
const modalities = [
  { label: 'SEQ', tone: 'bright' },
  { label: 'STR', tone: 'violet' },
  { label: 'EXPR', tone: 'cyan' },
  { label: 'POP', tone: 'green' },
];
const evidence = [
  { y: 54, w: 148 }, { y: 78, w: 106 }, { y: 102, w: 186 }, { y: 126, w: 76 }, { y: 150, w: 128 },
];
---
<section class="relative bg-bg" aria-labelledby="directions-title">
  <div class="container-page py-12 md:py-16 lg:py-20">
    <div class="mb-9 flex max-w-3xl flex-col gap-3 lg:mb-12">
      <Eyebrow>Research directions</Eyebrow>
      <h2 id="directions-title" class="text-h2 text-ink">Four questions we are working on.</h2>
      <p class="max-w-prose text-body-lg text-ink-2">
        Open directions, stated as questions because that is what they still are.
      </p>
    </div>

    <div class="rd-root grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-12" data-active="0">
      <!-- Diagram panel -->
      <div class="order-1 lg:order-2 lg:col-span-5">
        <div class="sticky top-20 lg:top-28">
          {/* Capped below `lg`, where the panel would otherwise stretch the
              whole column width and blow the schematic up out of scale. */}
          <div class="mx-auto w-full max-w-[30rem] overflow-hidden rounded-lg border border-line bg-bg-elevated lg:max-w-none">
            <div class="rd-stage relative h-[30vh] min-h-[176px] w-full sm:h-auto sm:aspect-[4/3]">
              <svg viewBox="0 0 320 240" class="absolute inset-0 h-full w-full" aria-hidden="true" preserveAspectRatio="xMidYMid meet">
                <!-- 01 · genomic representation -->
                <g class="rd-fig is-on" data-fig="0">
                  <text x="30" y="34" class="rd-micro">SEQUENCE + VARIANT</text>
                  {seqBars.map((b) => (
                    <rect x={b.x} y="54" width="7" height="16" rx="1"
                      class={b.j === 8 ? 'rd-sbar rd-sbar--on' : 'rd-sbar'}
                      style={`--d:${(b.j * 0.045).toFixed(3)}s`} />
                  ))}
                  {[80, 160, 240].map((x, i) => (
                    <path d={`M${x} 84 L${x} 98 M${x - 4} 93 L${x} 98 L${x + 4} 93`} class="rd-tick rd-tick--drop" style={`--d:${(0.9 + i * 0.14).toFixed(2)}s`} />
                  ))}
                  {encBlocks.map((x, i) => (
                    <g class="rd-encgroup" style={`--d:${(1.2 + i * 0.1).toFixed(2)}s`}>
                      <rect x={x} y="118" width="44" height="38" rx="2" class={i === 3 ? 'rd-enc rd-enc--absent' : 'rd-enc'} />
                      {i !== 3 && [128, 136, 144].map((y, k) => (
                        <line x1={x + 8} y1={y} x2={x + 36 - k * 8} y2={y} class="rd-encline" />
                      ))}
                      {i === 3 && <text x={x + 22} y={140} class="rd-micro rd-micro--mid rd-micro--faint">?</text>}
                    </g>
                  ))}
                  <path d="M26 172 L26 178 L302 178 L302 172" class="rd-bracket" />
                  <text x="164" y="204" class="rd-micro rd-micro--mid">MEANING SURVIVES THE ENCODING</text>
                </g>

                <!-- 02 · multimodal modelling -->
                <g class="rd-fig" data-fig="1">
                  {modalities.map((m, i) => {
                    const y = 64 + i * 42;
                    return (
                      <g class={`rd-modality rd-modality--${m.tone}`} style={`--d:${(i * 1.7).toFixed(2)}s`}>
                        <text x="22" y={y + 3} class="rd-micro">{m.label}</text>
                        {[0, 1, 2, 3].map((k) => <rect x={62 + k * 15} y={y - 5} width="9" height="10" rx="1" class="rd-mbar" />)}
                        <path d={`M126 ${y} C 168 ${y}, 168 139, 196 139`} class="rd-merge" />
                        <path d={`M126 ${y} C 168 ${y}, 168 139, 196 139`} class="rd-mpulse" />
                      </g>
                    );
                  })}
                  {[100, 128, 156].map((y, i) => (
                    <rect x="200" y={y} width="92" height="22" rx="2" class="rd-layer" style={`--d:${(0.5 + i * 0.14).toFixed(2)}s`} />
                  ))}
                  <text x="246" y="210" class="rd-micro rd-micro--mid">ONE JOINT VIEW</text>
                  <text x="22" y="40" class="rd-micro">MODALITIES</text>
                </g>

                <!-- 03 · variant interpretation -->
                <g class="rd-fig" data-fig="2">
                  <text x="30" y="34" class="rd-micro">LINES OF EVIDENCE</text>
                  {evidence.map((e, i) => (
                    <g>
                      <rect x="30" y={e.y + 4 - 4.5} width={e.w} height="9" rx="1.5" class={i === 2 ? 'rd-ebar rd-ebar--on' : 'rd-ebar'} style={`--d:${(i * 0.08).toFixed(2)}s`} />
                      <circle cx={30 + e.w + 9} cy={e.y + 4} r="2.6" class="rd-edot" />
                    </g>
                  ))}
                  <line x1="232" y1="44" x2="232" y2="168" class="rd-threshold" />
                  <text x="266" y="48" class="rd-micro rd-micro--mid">FRAME</text>
                  <path d="M118 172 L118 186 M113 181 L118 186 L123 181" class="rd-tick" />
                  <rect x="34" y="192" width="168" height="26" rx="2" class="rd-concl" />
                  <text x="118" y="208" class="rd-micro rd-micro--mid">WEIGHTED CONCLUSION</text>
                  <text x="256" y="208" class="rd-micro rd-micro--mid">TRACEABLE</text>
                </g>

                <!-- 04 · predictive biological systems (planned) -->
                <g class="rd-fig" data-fig="3">
                  <text x="24" y="36" class="rd-micro">ESTABLISHED</text>
                  <text x="296" y="36" class="rd-micro rd-micro--end rd-micro--faint">PROPOSED</text>
                  {[82, 124, 166].map((y) => <circle cx="46" cy={y} r="5" class="rd-pnode" />)}
                  {[102, 146].map((y) => <circle cx="112" cy={y} r="5" class="rd-pnode" />)}
                  {[82, 124, 166].flatMap((y1) => [102, 146].map((y2) => (
                    <path d={`M46 ${y1} C 80 ${y1}, 80 ${y2}, 112 ${y2}`} class="rd-pedge" />
                  )))}
                  <line x1="160" y1="56" x2="160" y2="198" class="rd-boundary" />
                  {[102, 146].flatMap((y1) => [92, 134, 176].map((y2) => (
                    <path d={`M112 ${y1} C 150 ${y1}, 170 ${y2}, 208 ${y2}`} class="rd-pedge rd-pedge--ghost" />
                  )))}
                  {/* A single dim probe crossing into the proposed half — a
                      hypothesis being put forward, deliberately colourless. */}
                  {[{ y1: 102, y2: 134 }, { y1: 146, y2: 176 }].map((e, i) => (
                    <path d={`M112 ${e.y1} C 150 ${e.y1}, 170 ${e.y2}, 208 ${e.y2}`} class="rd-probe" style={`--d:${(i * 4).toFixed(1)}s`} />
                  ))}
                  {[92, 134, 176].map((y) => <circle cx="208" cy={y} r="5" class="rd-pnode rd-pnode--ghost" />)}
                  {[114, 156].map((y) => <circle cx="272" cy={y} r="5" class="rd-pnode rd-pnode--ghost" />)}
                  {[92, 134, 176].flatMap((y1) => [114, 156].map((y2) => (
                    <path d={`M208 ${y1} C 240 ${y1}, 240 ${y2}, 272 ${y2}`} class="rd-pedge rd-pedge--ghost" />
                  )))}
                  <text x="160" y="220" class="rd-micro rd-micro--mid rd-micro--faint">HYPOTHESES WORTH TESTING</text>
                </g>
              </svg>
            </div>

            <div class="flex items-center justify-between gap-4 border-t border-line-faint px-4 py-2.5">
              <p class="label text-ink-muted" data-rd-caption>{captions[0]}</p>
              <p class="label text-accent-text" data-rd-index aria-hidden="true">01</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Directions -->
      <ul class="rd-list order-2 flex flex-col lg:order-1 lg:col-span-7">
        {pillars.map((p, i) => (
          <li class="rd-row border-t border-line last:border-b" data-i={i} data-active={i === 0 ? 'true' : 'false'} data-caption={captions[i]}>
            <div class="relative py-6 pl-5 pr-1 lg:py-7">
              <span class="rd-mark" aria-hidden="true"></span>
              <div class="flex items-start justify-between gap-4">
                <h3 class="flex flex-col gap-2">
                  <span class="label text-ink-muted" aria-hidden="true">{p.index}</span>
                  <button type="button" class="rd-btn text-left text-h3 text-ink transition-colors" aria-pressed={i === 0 ? 'true' : 'false'}>
                    {p.title}
                  </button>
                </h3>
                {p.status !== 'active' && <StatusBadge status={p.status} class="mt-6 shrink-0" />}
              </div>

              <p class="rd-brief mt-3 max-w-prose text-body text-ink-2">{p.brief}</p>

              {/* Always shown: expanding the active row on scroll moved everything below it
                  (layout shift). The active row is marked by the rule, the title colour and the diagram. */}
              <ul class="mt-4 flex flex-col gap-1.5 border-l border-accent/40 pl-4">
                {p.directions.map((d) => <li class="text-body-sm text-ink-muted">{d}</li>)}
              </ul>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('.rd-root');
  const list = root?.querySelector<HTMLElement>('.rd-list');
  const rows = Array.from(root?.querySelectorAll<HTMLElement>('.rd-row') ?? []);
  const figs = Array.from(root?.querySelectorAll<SVGGElement>('.rd-fig') ?? []);
  const caption = root?.querySelector<HTMLElement>('[data-rd-caption]');
  const indexOut = root?.querySelector<HTMLElement>('[data-rd-index]');

  if (root && list && rows.length && figs.length) {
    let active = -1;
    /* While the pointer is in the list, or focus is inside it, the person is
       driving — the scroll fallback must not pull the panel back. */
    let pointerInList = false;
    let focusInList = false;
    const driven = () => pointerInList || focusInList;

    const setActive = (i: number) => {
      if (i === active || i < 0 || i >= rows.length) return;
      active = i;
      root.dataset.active = String(i);
      rows.forEach((r, n) => {
        r.dataset.active = String(n === i);
        r.querySelector('.rd-btn')?.setAttribute('aria-pressed', String(n === i));
      });
      figs.forEach((f, n) => f.classList.toggle('is-on', n === i));
      if (caption) caption.textContent = rows[i].dataset.caption ?? '';
      if (indexOut) indexOut.textContent = String(i + 1).padStart(2, '0');
    };

    rows.forEach((row, i) => {
      row.addEventListener('pointerenter', () => setActive(i));
      row.addEventListener('click', () => setActive(i));
      row.querySelector('.rd-btn')?.addEventListener('focus', () => setActive(i));
    });

    list.addEventListener('pointerenter', () => { pointerInList = true; });
    list.addEventListener('pointerleave', () => { pointerInList = false; });
    list.addEventListener('focusin', () => { focusInList = true; });
    list.addEventListener('focusout', (e) => {
      if (!list.contains(e.relatedTarget as Node | null)) focusInList = false;
    });

    /* Scroll fallback: whichever row sits closest to the middle of the
       viewport becomes active, so the panel is never out of step. */
    const io = new IntersectionObserver(
      () => {
        if (driven()) return;
        const mid = window.innerHeight / 2;
        let best = 0;
        let bestDist = Infinity;
        rows.forEach((r, i) => {
          const box = r.getBoundingClientRect();
          const dist = Math.abs(box.top + box.height / 2 - mid);
          if (dist < bestDist) { bestDist = dist; best = i; }
        });
        setActive(best);
      },
      { threshold: [0, 0.25, 0.5, 0.75, 1], rootMargin: '-15% 0px -15% 0px' },
    );
    rows.forEach((r) => io.observe(r));

    setActive(0);
  }
</script>

<style>
  /* ------------------------------------------------------------------
     Same discipline as the pipeline diagrams: neutral field, neutral
     motion, accent blue only on the thing being pointed at and on the
     active row. The four modality hues in figure 02 are the exception,
     because there the colour is the information.
     ------------------------------------------------------------------ */
  .rd-micro {
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: 0.13em;
    fill: var(--color-ink-muted);
  }
  .rd-micro--mid { text-anchor: middle; }
  .rd-micro--end { text-anchor: end; }
  .rd-micro--faint { fill: var(--color-ink-faint); }

  .rd-fig {
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: opacity 480ms var(--ease-out-quart), transform 620ms var(--ease-out-quart), visibility 0s linear 500ms;
  }
  .rd-fig.is-on {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }

  /* A short dash travelling a path, then resting for the rest of its cycle. */
  @keyframes rd-flow {
    0%        { stroke-dashoffset: 260; opacity: 0; }
    6%        { opacity: 0.9; }
    40%       { opacity: 0.9; }
    46%, 100% { stroke-dashoffset: -40; opacity: 0; }
  }

  /* --- 01 · genomic representation ------------------------------------ */
  .rd-sbar {
    fill: var(--color-fig-line);
    opacity: 0;
    transform: translateY(-6px);
    transition: opacity 500ms ease-out, transform 600ms var(--ease-out-quart);
    transition-delay: var(--d, 0s);
  }
  .rd-fig.is-on .rd-sbar { opacity: 0.8; transform: none; }
  .rd-sbar--on { fill: var(--color-sci-green); }
  .rd-fig.is-on .rd-sbar--on { opacity: 0.95; }

  .rd-tick { fill: none; stroke: var(--color-fig-mid); stroke-width: 1.2; }
  .rd-tick--drop {
    opacity: 0;
    transform: translateY(-5px);
    transition: opacity 450ms ease-out, transform 550ms var(--ease-out-quart);
    transition-delay: var(--d, 0s);
  }
  .rd-fig.is-on .rd-tick--drop { opacity: 0.8; transform: none; }

  .rd-encgroup {
    opacity: 0;
    transition: opacity 550ms ease-out;
    transition-delay: var(--d, 0s);
  }
  .rd-fig.is-on .rd-encgroup { opacity: 1; }
  .rd-enc { fill: var(--color-surface); stroke: var(--color-line-strong); stroke-width: 1; }
  .rd-enc--absent { fill: none; stroke: var(--color-ink-faint); stroke-dasharray: 2 2.5; }
  .rd-encline { stroke: color-mix(in srgb, var(--color-sci-blue) 70%, transparent); stroke-width: 1.4; opacity: 0.75; }
  .rd-bracket { fill: none; stroke: var(--color-line); stroke-width: 1; }

  /* --- 02 · multimodal modelling -------------------------------------- */
  /* Class names follow the data's `tone` field; the values map onto the
     research palette — signal, rare emphasis, biology, computation. */
  .rd-modality--bright { --tone: var(--color-sci-blue); }
  .rd-modality--violet { --tone: var(--color-sci-coral); }
  .rd-modality--cyan   { --tone: var(--color-sci-green); }
  .rd-modality--green  { --tone: var(--color-sci-amber); }

  .rd-mbar { fill: var(--tone, var(--color-fig-line)); opacity: 0.5; }
  .rd-merge { fill: none; stroke: var(--tone, var(--color-fig-line)); stroke-width: 1; opacity: 0.55; }
  .rd-mpulse {
    fill: none;
    stroke: var(--tone, var(--color-fig-bright));
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-dasharray: 4 260;
    opacity: 0;
  }
  .rd-fig.is-on .rd-mpulse { animation: rd-flow 9s linear infinite; animation-delay: var(--d, 0s); }

  /* The joint view is neutral: four inputs, one shared representation. */
  .rd-layer { fill: color-mix(in srgb, var(--color-sci-blue) 9%, transparent); stroke: color-mix(in srgb, var(--color-sci-blue) 55%, transparent); stroke-width: 1; opacity: 0.85; }
  .rd-fig.is-on .rd-layer { animation: rd-layer 9s ease-in-out infinite; animation-delay: var(--d, 0s); }
  @keyframes rd-layer { 0%, 100% { opacity: 0.55; } 50% { opacity: 1; } }

  /* --- 03 · variant interpretation ------------------------------------ */
  .rd-ebar {
    fill: var(--color-fig-line);
    transform: scaleX(0);
    transform-box: fill-box;
    transform-origin: left;
    transition: transform 900ms var(--ease-out-quart);
    transition-delay: var(--d, 0s);
  }
  /* One line of evidence carries the weight — that one gets the accent. */
  .rd-ebar--on { fill: var(--color-sci-blue); opacity: 0.7; }
  .rd-fig.is-on .rd-ebar { transform: none; }
  .rd-edot { fill: var(--color-sci-amber); opacity: 0.85; }
  .rd-threshold { stroke: var(--color-fig-mid); stroke-width: 1; stroke-dasharray: 3 4; opacity: 0.5; }
  .rd-concl { fill: color-mix(in srgb, var(--color-sci-blue) 16%, transparent); stroke: var(--color-sci-blue); stroke-width: 1; opacity: 0.95; }

  /* --- 04 · predictive systems ----------------------------------------
     One restrained accent on the probe only. Nothing here is established, so
     the ghosted nodes and edges stay grey and the figure keeps less visual
     authority than the other three. */
  .rd-pnode { fill: var(--color-bg); stroke: color-mix(in srgb, var(--color-sci-green) 60%, var(--color-fig-mid)); stroke-width: 1.3; }
  .rd-pnode--ghost { stroke: var(--color-ink-faint); stroke-dasharray: 2 2.5; }
  .rd-pedge { fill: none; stroke: var(--color-line-strong); stroke-width: 1; opacity: 0.6; }
  .rd-pedge--ghost { stroke: var(--color-ink-faint); stroke-dasharray: 2 3; opacity: 0.45; }
  .rd-boundary { stroke: var(--color-line-strong); stroke-width: 1; stroke-dasharray: 4 5; }
  .rd-probe {
    fill: none;
    stroke: color-mix(in srgb, var(--color-sci-blue) 70%, transparent);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-dasharray: 4 240;
    opacity: 0;
  }
  .rd-fig.is-on .rd-probe { animation: rd-flow 11s linear infinite; animation-delay: var(--d, 0s); }

  /* --- list ----------------------------------------------------------- */
  .rd-mark {
    position: absolute;
    left: 0;
    top: 1.5rem;
    bottom: 1.5rem;
    width: 2px;
    background: var(--color-accent);
    transform: scaleY(0);
    transform-origin: center;
    transition: transform 420ms var(--ease-out-quart);
  }
  .rd-row[data-active='true'] .rd-mark { transform: scaleY(1); }

  /* A neutral lift on the active row, not a blue wash. */
  .rd-row { transition: background-color 320ms ease-out; }
  .rd-row[data-active='true'] {
    background: linear-gradient(to right, color-mix(in srgb, var(--color-fig-bright) 4%, transparent), transparent 65%);
  }
  .rd-btn { cursor: pointer; }
  .rd-row[data-active='true'] .rd-btn { color: var(--color-accent-text); }
  .rd-row:not([data-active='true']) .rd-brief { color: var(--color-ink-muted); }

  @media (prefers-reduced-motion: reduce) {
    .rd-fig, .rd-mark, .rd-ebar, .rd-sbar, .rd-tick--drop, .rd-encgroup { transition: none; }
    .rd-ebar, .rd-sbar, .rd-tick--drop { transform: none; }
    .rd-sbar { opacity: 0.8; }
    .rd-fig :global(*) { animation: none !important; }
    .rd-mpulse, .rd-probe { display: none; }
  }
</style>

---
/**
 * Hero figure — an abstract signal path, read top to bottom:
 * sequence track → one highlighted variant → its biological context →
 * a lattice of computation → a single converged result.
 *
 * Colour discipline: the field is neutral. Structure, motion and the node
 * lattice are greys and a warm off-white; accent blue appears exactly twice —
 * on the variant that is being followed, and on the result it produces.
 * Connections form slowly and occasionally rather than pulsing continuously.
 *
 * Pure SVG + CSS. Animation only runs while the figure is on screen
 * (data-live) and is switched off entirely under prefers-reduced-motion.
 */

/* Deterministic pseudo-random: the server render must be stable. */
const rnd = (i: number) => {
  const x = Math.sin(i * 12.9898) * 43758.5453;
  return x - Math.floor(x);
};

const N = 46;
const VAR = 24;
const X0 = 16;
const GAP = 7.55;
const BASE = 100;
const bx = (i: number) => X0 + i * GAP;

const bars = Array.from({ length: N }, (_, i) => ({ i, x: bx(i), h: 7 + Math.round(rnd(i) * 25) }));
const vx = bx(VAR) + 1.7;

const context = [
  { x: 80, label: 'GENE' },
  { x: 197, label: 'PROTEIN' },
  { x: 314, label: 'POPULATION' },
];
const CY = 176;

const L1 = [55, 126, 197, 268, 339];
const L2 = [90, 161, 232, 303];
const L3 = [126, 197, 268];
const Y1 = 232, Y2 = 284, Y3 = 336, YF = 392;

type Edge = { x1: number; y1: number; x2: number; y2: number };

/* Sparse lattice: each node reaches the two nearest nodes in the row above. */
const e12: Edge[] = L2.flatMap((x2, j) => [L1[j], L1[j + 1]].map((x1) => ({ x1, y1: Y1, x2, y2: Y2 })));
const e23: Edge[] = L3.flatMap((x3, k) => [L2[k], L2[k + 1]].map((x2) => ({ x1: x2, y1: Y2, x2: x3, y2: Y3 })));
const e3f: Edge[] = L3.map((x3) => ({ x1: x3, y1: Y3, x2: 197, y2: YF }));
const eC1: Edge[] = [
  { x1: 80, x2: 55 }, { x1: 80, x2: 126 },
  { x1: 197, x2: 197 },
  { x1: 314, x2: 339 }, { x1: 314, x2: 268 },
].map((e) => ({ ...e, y1: CY + 9, y2: Y1 }));

const lattice = [...eC1, ...e12, ...e23, ...e3f];

/* A handful of edges brighten and fade on long, offset cycles — connections
   forming rather than a field of permanently lit wires. */
const forming = new Set([1, 5, 9, 12, 17, 21]);

/* One highlighted route: the signal that actually gets followed. */
const route: Edge[] = [
  { x1: 197, y1: Y1, x2: 161, y2: Y2 },
  { x1: 161, y1: Y2, x2: 197, y2: Y3 },
  { x1: 197, y1: Y3, x2: 197, y2: YF },
];

const curve = (e: Edge) => {
  const my = (e.y1 + e.y2) / 2;
  return `M${e.x1} ${e.y1} C ${e.x1} ${my}, ${e.x2} ${my}, ${e.x2} ${e.y2}`;
};
---
<figure class="rh-figure" data-live="false">
  <svg viewBox="0 0 380 440" class="block h-full w-full" role="img" aria-labelledby="rh-t rh-d" preserveAspectRatio="xMidYMid meet">
    <title id="rh-t">A genomic signal traced through a computational system</title>
    <desc id="rh-d">A sequence track with one variant highlighted, connected to gene, protein and population context, passing through layers of computation and converging on a single evidence-weighted result.</desc>

    <defs>
      <linearGradient id="rh-sweep" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%" stop-color="var(--color-fig-bright)" stop-opacity="0" />
        <stop offset="50%" stop-color="var(--color-fig-bright)" stop-opacity="0.16" />
        <stop offset="100%" stop-color="var(--color-fig-bright)" stop-opacity="0" />
      </linearGradient>
    </defs>

    <!-- 1 · sequence track -->
    <g class="rh-track">
      {bars.map((b) => (
        <rect
          x={b.i === VAR ? b.x - 0.6 : b.x} y={b.i === VAR ? BASE - 30 : BASE - b.h}
          width={b.i === VAR ? 4.6 : 3.4} height={b.i === VAR ? 30 : b.h} rx="0.6"
          class={b.i === VAR ? 'rh-bar rh-bar--var' : 'rh-bar'}
          style={`--o:${(0.4 + rnd(b.i + 40) * 0.5).toFixed(2)}`}
        />
      ))}
      <line x1="12" y1={BASE + 5} x2="368" y2={BASE + 5} class="rh-baseline" />
      <rect class="rh-scan" x="6" y={BASE - 40} width="52" height="47" />
      <text x="12" y="24" class="rh-micro">SEQUENCE</text>
    </g>

    <!-- variant marker: the one thing worth pointing at -->
    <g class="rh-var">
      <line x1={vx} y1={BASE - 42} x2={vx} y2={BASE - 32} class="rh-var-tick" />
      <circle cx={vx} cy={BASE - 48} r="11" class="rh-var-halo" />
      <circle cx={vx} cy={BASE - 48} r="4" class="rh-var-dot" />
      <text x={vx + 18} y={BASE - 45} class="rh-micro rh-micro--on">VARIANT</text>
    </g>

    <!-- 2 · context. Structure and pulse are separate paths, so the connection
         stays legible when nothing is animating. -->
    <g class="rh-context">
      {context.map((c, i) => (
        <g style={`--d:${(i * 2.6).toFixed(1)}s`}>
          <path d={curve({ x1: vx, y1: BASE + 10, x2: c.x, y2: CY - 9 })} class="rh-link" />
          <path d={curve({ x1: vx, y1: BASE + 10, x2: c.x, y2: CY - 9 })} class={`rh-pulse rh-pulse--${['bio', 'proc', 'signal'][i]}`} />
          <rect x={c.x - 7} y={CY - 7} width="14" height="14" rx="1.5" class={`rh-chip rh-chip--${['gene', 'protein', 'population'][i]}`} />
          <text x={c.x} y={CY + 26} class="rh-micro rh-micro--mid">{c.label}</text>
        </g>
      ))}
    </g>

    <!-- 3 · lattice -->
    <g class="rh-lattice">
      {lattice.map((e, i) => (
        <path
          d={curve(e)}
          class={forming.has(i) ? 'rh-edge rh-edge--forming' : 'rh-edge'}
          style={forming.has(i) ? `--d:${(i * 1.9).toFixed(1)}s` : undefined}
        />
      ))}
      {route.map((e) => <path d={curve(e)} class="rh-edge rh-edge--route" />)}
      {route.map((e, i) => (
        <path
          d={curve(e)}
          class:list={['rh-pulse', 'rh-pulse--route', ['rh-pulse--bio', 'rh-pulse--signal', 'rh-pulse--proc'][i % 3]]}
          style={`--d:${(i * 1.1).toFixed(2)}s`}
        />
      ))}
      {L1.map((x, i) => <circle cx={x} cy={Y1} r="4" class="rh-node rh-node--bio" style={`--d:${(i * 1.3).toFixed(2)}s`} />)}
      {L2.map((x, i) => <circle cx={x} cy={Y2} r="4" class:list={['rh-node', i === 2 ? 'rh-node--mark' : 'rh-node--signal']} style={`--d:${(0.7 + i * 1.3).toFixed(2)}s`} />)}
      {L3.map((x, i) => <circle cx={x} cy={Y3} r="4" class="rh-node rh-node--proc" style={`--d:${(1.4 + i * 1.3).toFixed(2)}s`} />)}
      <text x="12" y={Y2 + 3} class="rh-micro">LAYERS</text>
    </g>

    <!-- 4 · result: the second and last place blue appears -->
    <g class="rh-out">
      <circle cx="197" cy={YF} r="21" class="rh-ring" />
      <circle cx="197" cy={YF} r="7.5" class="rh-core" />
      <text x="197" y={YF + 38} class="rh-micro rh-micro--mid">EVIDENCE-WEIGHTED RESULT</text>
    </g>
  </svg>
</figure>

<script>
  const fig = document.querySelector<HTMLElement>('.rh-figure');
  if (fig) {
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => { fig.dataset.live = String(e.isIntersecting); }),
      { rootMargin: '15% 0px' },
    );
    io.observe(fig);
  }
</script>

<style>
  .rh-micro {
    font-family: var(--font-mono);
    font-size: 7.5px;
    letter-spacing: 0.14em;
    fill: var(--color-ink-muted);
  }
  .rh-micro--mid { text-anchor: middle; }
  .rh-micro--on { fill: var(--color-ink-2); }

  /* --- neutral field -------------------------------------------------- */
  .rh-bar { fill: var(--color-fig-line); opacity: var(--o, 0.7); }
  .rh-baseline { stroke: var(--color-line-faint); stroke-width: 1; }
  .rh-scan { fill: url(#rh-sweep); opacity: 0; }

  .rh-link { fill: none; stroke: var(--color-line-strong); stroke-width: 1; opacity: 0.55; }
  /* Gene, protein and population context: three kinds of evidence, three
     hues, all quiet enough to stay behind the variant and the result. */
  .rh-chip { fill: var(--color-bg); stroke: var(--color-fig-mid); stroke-width: 1; opacity: 0.8; }
  .rh-chip--gene { stroke: var(--color-sci-green); }
  .rh-chip--protein { stroke: var(--color-sci-amber); }
  .rh-chip--population { stroke: var(--color-sci-blue); }

  .rh-edge { fill: none; stroke: var(--color-line); stroke-width: 1; }
  .rh-edge--forming { opacity: 0.35; }
  .rh-edge--route { stroke: var(--color-fig-mid); stroke-width: 1.1; opacity: 0.5; }
  /* Inactive nodes stay graphite; --node-on is the state each layer resolves
     to while it is active, so the layers read as different kinds of work. */
  .rh-node { fill: var(--color-bg); stroke: var(--color-fig-line); stroke-width: 1.2; --node-on: var(--color-fig-bright); }
  .rh-node--bio { --node-on: var(--color-sci-green); }
  .rh-node--signal { --node-on: var(--color-sci-blue); }
  .rh-node--proc { --node-on: var(--color-sci-amber); }
  .rh-node--mark { --node-on: var(--color-sci-coral); }

  /* A short dash travelling along a route the structural stroke already draws.
     Warm off-white, not blue — the motion is neutral, the meaning is not. */
  .rh-pulse {
    fill: none;
    stroke: var(--pulse-ink, var(--color-fig-bright));
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-dasharray: 4 260;
    opacity: 0;
  }
  .rh-pulse--route { stroke-width: 1.8; }
  .rh-pulse--bio { --pulse-ink: var(--color-sci-green); }
  .rh-pulse--signal { --pulse-ink: var(--color-sci-blue); }
  .rh-pulse--proc { --pulse-ink: var(--color-sci-amber); }

  /* --- the two blue moments ------------------------------------------- */
  .rh-bar--var { fill: var(--color-sci-green); opacity: 0.9; }
  .rh-var-dot { fill: var(--color-sci-green); }
  .rh-var-tick { stroke: var(--color-sci-green); stroke-width: 1; opacity: 0.45; }
  .rh-var-halo {
    fill: none;
    stroke: var(--color-sci-green);
    stroke-width: 1;
    opacity: 0.26;
    transform-box: fill-box;
    transform-origin: center;
  }
  .rh-ring {
    fill: none;
    stroke: color-mix(in srgb, var(--color-sci-blue) 55%, transparent);
    stroke-width: 1;
    stroke-dasharray: 3 7;
    opacity: 0.8;
    transform-box: fill-box;
    transform-origin: center;
  }
  .rh-core { fill: var(--color-sci-blue); opacity: 0.9; }

  /* --- motion, only while the figure is on screen ----------------------
     Long cycles with wide offsets: at any moment only one or two things are
     moving, and nothing repeats often enough to pull the eye off the text. */
  .rh-figure[data-live='true'] .rh-scan { animation: rh-scan 16s ease-in-out infinite; }
  .rh-figure[data-live='true'] .rh-var-halo { animation: rh-halo 7s ease-in-out infinite; }
  .rh-figure[data-live='true'] .rh-pulse {
    animation: rh-flow 8s linear infinite;
    animation-delay: var(--d, 0s);
  }
  .rh-figure[data-live='true'] .rh-pulse--route { animation-duration: 7s; }
  .rh-figure[data-live='true'] .rh-edge--forming { animation: rh-form 11s ease-in-out infinite; animation-delay: var(--d, 0s); }
  .rh-figure[data-live='true'] .rh-node { animation: rh-node 13s ease-in-out infinite; animation-delay: var(--d, 0s); }
  .rh-figure[data-live='true'] .rh-ring { animation: rh-spin 90s linear infinite; }
  .rh-figure[data-live='true'] .rh-core { animation: rh-core 7s ease-in-out infinite; }

  @keyframes rh-scan {
    0%   { transform: translateX(0); opacity: 0; }
    10%  { opacity: 1; }
    80%  { opacity: 1; }
    100% { transform: translateX(320px); opacity: 0; }
  }
  @keyframes rh-halo {
    0%, 100% { opacity: 0.08; transform: scale(0.82); }
    50%      { opacity: 0.3; transform: scale(1.06); }
  }
  /* The pulse occupies only part of the cycle, so the path rests between runs. */
  @keyframes rh-flow {
    0%       { stroke-dashoffset: 240; opacity: 0; }
    6%       { opacity: 0.85; }
    44%      { opacity: 0.85; }
    50%, 100% { stroke-dashoffset: -60; opacity: 0; }
  }
  @keyframes rh-form {
    0%, 100% { opacity: 0.12; }
    50%      { opacity: 0.6; }
  }
  @keyframes rh-node {
    0%, 100% { stroke: var(--color-fig-line); }
    50%      { stroke: var(--node-on); }
  }
  @keyframes rh-spin { to { transform: rotate(360deg); } }
  @keyframes rh-core { 0%, 100% { opacity: 0.5; } 50% { opacity: 0.95; } }

  @media (prefers-reduced-motion: reduce) {
    .rh-figure :global(*) { animation: none !important; }
    .rh-scan, .rh-pulse { display: none; }
    .rh-edge--forming { opacity: 0.35; }
  }
</style>

---
/**
 * The four pipeline-stage diagrams. One component, one `stage` prop, so the
 * pipeline template stays readable and every diagram shares the same idiom:
 * 360×200 viewBox, hairline strokes, mono micro-labels, motion gated on
 * `data-live` (set by the pipeline's IntersectionObserver).
 *
 * Each diagram is meant to carry the stage's idea on its own — the text
 * beside it explains, it does not decode a puzzle.
 */
import type { ResearchStage } from '@/data/content';
interface Props { stage: ResearchStage['id'] }
const { stage } = Astro.props;

/* ---------------------------------------------------- 01 · biological data */
const COL = (j: number) => 18 + j * 8.4;
const VAR_COL = 10;
const refBars = Array.from({ length: 22 }, (_, j) => j);
const reads = [
  { y: 58, from: 0, to: 13 },
  { y: 76, from: 4, to: 19 },
  { y: 94, from: 2, to: 17 },
];
const chips = [
  { y: 48, label: 'GENE' },
  { y: 96, label: 'PROTEIN REGION' },
  { y: 144, label: 'POPULATION' },
];

/* -------------------------------------------------- 02 · representation */
const rnd = (i: number) => {
  const x = Math.sin(i * 78.233) * 43758.5453;
  return x - Math.floor(x);
};
const GX = [215, 251, 287, 323];
const GY = [62, 100, 138];
const cells = GY.flatMap((y, r) => GX.map((x, c) => ({ x, y, absent: r === 2 && c === 2 })));
const dots = cells
  .filter((c) => !c.absent)
  .map((c, i) => {
    const sx = 30 + rnd(i * 2 + 1) * 118;
    const sy = 38 + rnd(i * 2 + 7) * 126;
    return { sx, sy, dx: +(c.x - sx).toFixed(1), dy: +(c.y - sy).toFixed(1), i };
  });

/* ------------------------------------------------------- 03 · modelling */
const IN = [60, 100, 140];
const LA = [50, 84, 118, 152];
const LB = [50, 84, 118, 152];
const LC = [67, 101, 135];
const XI = 34, XA = 112, XB = 190, XC = 266, XO = 328;
type E = { x1: number; y1: number; x2: number; y2: number; layer: number };
const mEdges: E[] = [
  ...IN.flatMap((y, i) => [LA[i], LA[i + 1]].filter((v) => v !== undefined).map((y2) => ({ x1: XI + 8, y1: y, x2: XA, y2, layer: 0 }))),
  ...LA.flatMap((y, i) => [LB[i], LB[i + 1]].filter((v) => v !== undefined).map((y2) => ({ x1: XA, y1: y, x2: XB, y2, layer: 1 }))),
  ...LC.flatMap((y3, k) => [LB[k], LB[k + 1]].filter((v) => v !== undefined).map((y1) => ({ x1: XB, y1, x2: XC, y2: y3, layer: 2 }))),
  ...LC.map((y) => ({ x1: XC, y1: y, x2: XO, y2: 101, layer: 3 })),
];
const mCurve = (e: E) => {
  const mx = (e.x1 + e.x2) / 2;
  return `M${e.x1} ${e.y1} C ${mx} ${e.y1}, ${mx} ${e.y2}, ${e.x2} ${e.y2}`;
};

/* --------------------------------------------------- 04 · interpretation
   The one place hues are used, because here they carry information: each
   stream is a different kind of evidence, and stroke weight is its weight.
   They converge on blue — the conclusion is the accent, the inputs are not. */
const streams = [
  { y: 44, label: 'SEQUENCE', w: 2.2, tone: 'bright' },
  { y: 78, label: 'PROTEIN', w: 1.6, tone: 'violet' },
  { y: 112, label: 'POPULATION', w: 1.3, tone: 'cyan' },
  { y: 146, label: 'CURATED', w: 1.9, tone: 'green' },
];
const sCurve = (y: number) => `M104 ${y} C 170 ${y}, 190 100, 233 100`;
---
{stage === 'data' && (
  <svg viewBox="0 0 360 200" class="sv" data-live="false" role="img" aria-label="Sequence reads aligned to a reference, with one variant column highlighted and connected to gene, protein region and population context.">
    <text x="18" y="24" class="sv-micro">READS · REFERENCE</text>

    <g class="sv-reads">
      {refBars.map((j) => (
        <rect x={COL(j)} y="32" width="4.4" height="12" rx="0.8"
          class={j === VAR_COL ? 'sv-bar sv-bar--var' : 'sv-bar'} style={`--d:${(j * 0.025).toFixed(3)}s`} />
      ))}
      {reads.map((r, ri) => refBars.filter((j) => j >= r.from && j <= r.to).map((j) => (
        <rect x={COL(j)} y={r.y} width="4.4" height="9" rx="0.8"
          class={j === VAR_COL ? 'sv-bar sv-bar--var' : 'sv-bar sv-bar--read'}
          style={`--d:${(0.15 + ri * 0.12 + (j - r.from) * 0.02).toFixed(3)}s`} />
      )))}
    </g>

    <line x1={COL(VAR_COL) + 2.2} y1="46" x2={COL(VAR_COL) + 2.2} y2="150" class="sv-guide" />
    <circle cx={COL(VAR_COL) + 2.2} cy="150" r="3" class="sv-junction" />

    <g class="sv-chips">
      {chips.map((c, i) => (
        <g style={`--d:${(0.55 + i * 0.13).toFixed(2)}s`}>
          <path d={`M${COL(VAR_COL) + 2.2} 150 C 170 150, 180 ${c.y + 12}, 232 ${c.y + 12}`} class="sv-draw sv-link" />
          <rect x="232" y={c.y} width="112" height="24" rx="2" class="sv-chip" />
          <text x="288" y={c.y + 15.5} class="sv-micro sv-micro--mid">{c.label}</text>
        </g>
      ))}
    </g>
  </svg>
)}

{stage === 'representation' && (
  <svg viewBox="0 0 360 200" class="sv" data-live="false" role="img" aria-label="Scattered observations moving into a structured grid of computational objects, with one cell left explicitly empty to mark missing information.">
    <text x="18" y="24" class="sv-micro">OBSERVED</text>
    <text x="342" y="24" class="sv-micro sv-micro--end">STRUCTURED</text>

    <g class="sv-frame">
      <rect x="197" y="44" width="144" height="112" rx="3" class="sv-draw sv-box" />
      {GX.map((x) => <line x1={x} y1="50" x2={x} y2="150" class="sv-rule" />)}
      {GY.map((y) => <line x1="203" y1={y} x2="335" y2={y} class="sv-rule" />)}
      {cells.filter((c) => c.absent).map((c) => (
        <rect x={c.x - 8} y={c.y - 8} width="16" height="16" rx="1.5" class="sv-absent" />
      ))}
    </g>

    {/* The origin of each observation stays visible, so the transformation
        still reads once the dots have settled into the grid. */}
    <g class="sv-origins">
      {dots.map((d) => <circle cx={d.sx} cy={d.sy} r="2.6" class="sv-origin" />)}
      <rect x="20" y="34" width="140" height="132" rx="3" class="sv-observed" />
    </g>

    <g class="sv-dots">
      {dots.map((d) => (
        <circle cx={d.sx} cy={d.sy} r="3.4" class="sv-dot"
          style={`--dx:${d.dx}px; --dy:${d.dy}px; --d:${(d.i * 0.05).toFixed(3)}s`} />
      ))}
    </g>

    <path d="M166 100 L186 100 M180 95 L186 100 L180 105" class="sv-arrow" />
    <text x="180" y="184" class="sv-micro sv-micro--mid sv-note">MISSING IS MARKED, NOT GUESSED</text>
  </svg>
)}

{stage === 'modelling' && (
  <svg viewBox="0 0 360 200" class="sv" data-live="false" role="img" aria-label="Structured inputs passing through three sparse layers of computation, activating layer by layer, resolving to a single estimate.">
    <text x="18" y="24" class="sv-micro">INPUT</text>
    <text x="342" y="24" class="sv-micro sv-micro--end">ESTIMATE</text>

    <g class="sv-edges">
      {mEdges.map((e, i) => (
        <path d={mCurve(e)} class="sv-draw sv-edge" style={`--d:${(e.layer * 0.18 + (i % 4) * 0.04).toFixed(3)}s; --l:${e.layer}`} />
      ))}
      {[{ x1: XI + 8, y1: 100, x2: XA, y2: 84, layer: 0 }, { x1: XA, y1: 84, x2: XB, y2: 118, layer: 1 }, { x1: XB, y1: 118, x2: XC, y2: 101, layer: 2 }, { x1: XC, y1: 101, x2: XO, y2: 101, layer: 3 }].map((e) => (
        <path d={mCurve(e as E)} class="sv-pulse sv-pulse--model" style={`--d:${(e.layer * 0.8).toFixed(2)}s`} />
      ))}
    </g>

    {IN.map((y, i) => <rect x={XI - 8} y={y - 8} width="16" height="16" rx="1.5" class="sv-inbox" style={`--d:${(i * 0.1).toFixed(2)}s`} />)}
    {/* Layer delays are wide enough that the activation reads as a wave
        travelling left to right, not as everything blinking at once. */}
    {LA.map((y, i) => <circle cx={XA} cy={y} r="4.5" class="sv-mnode" style={`--d:${(i * 0.12).toFixed(2)}s`} />)}
    {LB.map((y, i) => <circle cx={XB} cy={y} r="4.5" class="sv-mnode" style={`--d:${(0.9 + i * 0.12).toFixed(2)}s`} />)}
    {LC.map((y, i) => <circle cx={XC} cy={y} r="4.5" class="sv-mnode" style={`--d:${(1.8 + i * 0.12).toFixed(2)}s`} />)}
    <circle cx={XO} cy="101" r="7" class="sv-out" />
    <circle cx={XO} cy="101" r="14" class="sv-out-ring" />
    <text x="180" y="188" class="sv-micro sv-micro--mid sv-note">EACH ESTIMATE IS ONE LINE OF EVIDENCE</text>
  </svg>
)}

{stage === 'interpretation' && (
  <svg viewBox="0 0 360 200" class="sv" data-live="false" role="img" aria-label="Four evidence streams of different weights converging on a single node, producing a weighted readout.">
    {/* `--d` staggers the structural draw-in, `--p` offsets the pulse. They are
        separate: the diagram settles quickly, then breathes slowly. */}
    {streams.map((s, i) => (
      <g class={`sv-strand sv-strand--${s.tone}`} style={`--d:${(i * 0.16).toFixed(2)}s; --p:${(i * 2.2).toFixed(2)}s`}>
        <text x="18" y={s.y + 3} class="sv-micro">{s.label}</text>
        <rect x="96" y={s.y - 3.5} width="7" height="7" rx="1" class="sv-seed" />
        <path d={sCurve(s.y)} class="sv-draw sv-stream" style={`stroke-width:${s.w}`} />
        <path d={sCurve(s.y)} class="sv-pulse sv-pulse--stream" style={`stroke-width:${s.w}`} />
      </g>
    ))}

    <circle cx="250" cy="100" r="23" class="sv-conv-ring" />
    <circle cx="250" cy="100" r="14" class="sv-conv" />

    <path d="M266 100 L296 100" class="sv-draw sv-link" style="--d:1.1s" />
    <g class="sv-readout">
      {[{ x: 304, h: 26 }, { x: 316, h: 40 }, { x: 328, h: 16 }].map((b, i) => (
        <rect x={b.x} y={124 - b.h} width="8" height={b.h} rx="1"
          class={i === 1 ? 'sv-rbar sv-rbar--on' : 'sv-rbar'} style={`--d:${(1.3 + i * 0.12).toFixed(2)}s; --h:${b.h}px`} />
      ))}
      <line x1="300" y1="126" x2="340" y2="126" class="sv-rule" />
      <text x="320" y="142" class="sv-micro sv-micro--mid">WEIGHTED</text>
    </g>
    <text x="180" y="188" class="sv-micro sv-micro--mid sv-note">EVERY STEP OF THE REASONING IS RECORDED</text>
  </svg>
)}

<style>
  /* ------------------------------------------------------------------
     Colour discipline for all four stage diagrams:

       neutrals   carry structure and almost all motion
       accent     marks the one thing being followed (a variant) and the
                  one thing produced (an estimate, a conclusion)
       fig hues   appear only in stage 04, where four different kinds of
                  evidence genuinely need telling apart

     Motion is slow and intermittent — a pulse occupies part of its cycle
     and then rests, so the page is never uniformly in movement.
     ------------------------------------------------------------------ */
  .sv { display: block; width: 100%; height: 100%; }

  .sv-micro {
    font-family: var(--font-mono);
    font-size: 7.5px;
    letter-spacing: 0.13em;
    fill: var(--color-ink-muted);
  }
  .sv-micro--mid { text-anchor: middle; }
  .sv-micro--end { text-anchor: end; }

  /* Sentence-length notes are a bonus, not the message — below `sm` the panel
     is too narrow to render them legibly, so they are dropped. */
  .sv-note { display: none; }
  @media (min-width: 640px) {
    .sv-note { display: block; }
  }

  /* shared primitives -------------------------------------------------- */
  .sv-rule { stroke: var(--color-line-faint); stroke-width: 1; }
  .sv-link { fill: none; stroke: var(--color-fig-line); stroke-width: 1; opacity: 0.8; }

  /* structural strokes draw themselves in when the stage becomes live */
  .sv-draw {
    fill: none;
    stroke-dasharray: 320;
    stroke-dashoffset: 320;
    transition: stroke-dashoffset 1400ms var(--ease-out-quart);
    transition-delay: var(--d, 0s);
  }
  .sv[data-live='true'] .sv-draw { stroke-dashoffset: 0; }

  /* A short dash travelling a path, then resting. Neutral by default; a
     strand overrides `--tone` when its colour means something. */
  .sv-pulse {
    fill: none;
    stroke: var(--tone, var(--color-fig-bright));
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-dasharray: 4 300;
    opacity: 0;
  }
  .sv[data-live='true'] .sv-pulse {
    animation: sv-flow 7.5s linear infinite;
    animation-delay: var(--p, var(--d, 0s));
  }
  @keyframes sv-flow {
    0%        { stroke-dashoffset: 300; opacity: 0; }
    5%        { opacity: 0.9; }
    42%       { opacity: 0.9; }
    48%, 100% { stroke-dashoffset: -60; opacity: 0; }
  }

  /* 01 · data ---------------------------------------------------------- */
  .sv-bar {
    fill: var(--color-fig-line);
    opacity: 0;
    transform: translateX(-8px);
    transition: opacity 600ms ease-out, transform 750ms var(--ease-out-quart);
    transition-delay: var(--d, 0s);
  }
  .sv-bar--read { fill: var(--color-fig-line); opacity: 0; }
  .sv[data-live='true'] .sv-bar { opacity: 0.85; transform: none; }
  .sv[data-live='true'] .sv-bar--read { opacity: 0.5; }

  /* The variant column is the only accent in this diagram. */
  .sv-bar--var { fill: var(--color-sci-green); }
  .sv[data-live='true'] .sv-bar--var { opacity: 0.95; animation: sv-blink 6s ease-in-out infinite 1.2s; }
  @keyframes sv-blink { 0%, 100% { opacity: 0.55; } 50% { opacity: 0.95; } }

  .sv-guide {
    stroke: color-mix(in srgb, var(--color-sci-green) 70%, transparent);
    stroke-width: 1;
    stroke-dasharray: 2 3;
    opacity: 0.55;
    transform: scaleY(0);
    transform-origin: 0 46px;
    transition: transform 900ms var(--ease-out-quart) 550ms;
  }
  .sv[data-live='true'] .sv-guide { transform: none; }
  .sv-junction { fill: var(--color-sci-green); opacity: 0; transition: opacity 400ms 1.2s; }
  .sv[data-live='true'] .sv-junction { opacity: 0.9; }
  .sv-chip {
    fill: var(--color-surface);
    stroke: var(--color-line);
    stroke-width: 1;
    opacity: 0;
    transition: opacity 550ms ease-out;
    transition-delay: calc(var(--d, 0s) + 250ms);
  }
  .sv[data-live='true'] .sv-chip { opacity: 1; }

  /* 02 · representation ------------------------------------------------
     Entirely neutral: the idea here is order emerging, not emphasis. */
  .sv-origin { fill: none; stroke: var(--color-fig-line); stroke-width: 1; opacity: 0.45; }
  .sv-observed { fill: none; stroke: var(--color-line-faint); stroke-width: 1; stroke-dasharray: 2 3; }

  .sv-dot {
    fill: var(--color-fig-mid);
    transition: transform 1200ms var(--ease-out-quart), fill 1200ms ease-out;
    transition-delay: var(--d, 0s);
  }
  .sv[data-live='true'] .sv-dot {
    transform: translate(var(--dx), var(--dy));
    fill: var(--color-sci-blue);
  }
  .sv-box {
    stroke: var(--color-fig-line);
    stroke-width: 1;
    stroke-dasharray: 560;
    stroke-dashoffset: 560;
    transition-delay: 0.15s;
  }
  .sv[data-live='true'] .sv-box { stroke-dashoffset: 0; }
  .sv-absent { fill: none; stroke: var(--color-ink-faint); stroke-width: 1; stroke-dasharray: 2 2.5; }
  .sv-arrow { fill: none; stroke: color-mix(in srgb, var(--color-sci-blue) 75%, transparent); stroke-width: 1.2; opacity: 0; transition: opacity 500ms 0.6s; }
  .sv[data-live='true'] .sv-arrow { opacity: 0.85; }

  /* 03 · modelling -----------------------------------------------------
     Neutral activation wave; only the resolved estimate is accented. */
  .sv-edge { stroke: var(--color-line); stroke-width: 1; }
  .sv-inbox { fill: var(--color-bg); stroke: var(--color-sci-green); stroke-width: 1.2; }
  .sv-mnode { fill: var(--color-bg); stroke: var(--color-fig-line); stroke-width: 1.2; }
  .sv[data-live='true'] .sv-mnode { animation: sv-activate 7s ease-in-out infinite; animation-delay: var(--d, 0s); }
  @keyframes sv-activate {
    0%, 62%, 100% { stroke: var(--color-fig-line); fill: var(--color-bg); }
    16%, 30%      { stroke: var(--color-sci-amber); fill: color-mix(in srgb, var(--color-sci-amber) 18%, transparent); }
  }
  /* One cool note against all that grey, on the path that resolves. */
  .sv-pulse--model { --tone: var(--color-fig-cyan); }
  .sv-out { fill: var(--color-sci-blue); opacity: 0.9; }
  .sv-out-ring { fill: none; stroke: color-mix(in srgb, var(--color-sci-blue) 45%, transparent); stroke-width: 1; stroke-dasharray: 3 6; opacity: 0.7; transform-box: fill-box; transform-origin: center; }
  .sv[data-live='true'] .sv-out-ring { animation: sv-spin 48s linear infinite; }
  @keyframes sv-spin { to { transform: rotate(360deg); } }

  /* 04 · interpretation ------------------------------------------------
     One hue per kind of evidence; all of them converge on accent blue. */
  /* Class names follow the data's `tone` field; the values map onto the
     research palette — signal, rare emphasis, biology, computation. */
  .sv-strand--bright { --tone: var(--color-sci-blue); }
  .sv-strand--violet { --tone: var(--color-sci-coral); }
  .sv-strand--cyan   { --tone: var(--color-sci-green); }
  .sv-strand--green  { --tone: var(--color-sci-amber); }

  .sv-stream { stroke: var(--tone, var(--color-fig-mid)); opacity: 0.6; }
  .sv-pulse--stream { animation-duration: 9s !important; }
  .sv-seed { fill: var(--color-bg); stroke: var(--tone, var(--color-fig-mid)); stroke-width: 1; opacity: 0.8; }

  .sv-conv { fill: color-mix(in srgb, var(--color-sci-blue) 46%, transparent); stroke: var(--color-sci-blue); stroke-width: 1.2; }
  .sv[data-live='true'] .sv-conv { animation: sv-breathe 7s ease-in-out infinite; }
  @keyframes sv-breathe { 0%, 100% { opacity: 0.62; } 50% { opacity: 0.95; } }
  .sv-conv-ring { fill: none; stroke: color-mix(in srgb, var(--color-sci-blue) 45%, transparent); stroke-width: 1; stroke-dasharray: 3 7; opacity: 0.8; transform-box: fill-box; transform-origin: center; }
  .sv[data-live='true'] .sv-conv-ring { animation: sv-spin 70s linear infinite; }

  .sv-rbar {
    fill: var(--color-fig-line);
    transform: scaleY(0);
    transform-box: fill-box;
    transform-origin: bottom;
    transition: transform 850ms var(--ease-out-quart);
    transition-delay: var(--d, 0s);
  }
  .sv-rbar--on { fill: var(--color-sci-blue); }
  .sv[data-live='true'] .sv-rbar { transform: none; }

  /* ---------------------------------------------------------------- a11y */
  @media (prefers-reduced-motion: reduce) {
    .sv-draw { stroke-dasharray: none; stroke-dashoffset: 0; transition: none; }
    .sv-pulse { display: none; }
    .sv-bar { opacity: 0.85; transform: none; transition: none; }
    .sv-bar--read { opacity: 0.5; }
    .sv-bar--var { opacity: 0.95; }
    .sv-dot { transform: translate(var(--dx), var(--dy)); fill: var(--color-sci-blue); transition: none; }
    .sv-guide, .sv-arrow, .sv-junction, .sv-chip { transform: none; opacity: 1; transition: none; }
    .sv-rbar { transform: none; transition: none; }
    .sv :global(*) { animation: none !important; }
  }
</style>

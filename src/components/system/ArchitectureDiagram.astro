---
/**
 * Static SVG architecture diagram of the five-stage system.
 * Data-driven from `backbone`; renders horizontally on wide screens and
 * vertically on narrow ones (two SVGs, one hidden by breakpoint) so text
 * never shrinks below legibility.
 */
import { backbone } from '@/data/site';
interface Props { class?: string; caption?: string; sub?: Partial<Record<string, string[]>> }
const { class: className = '', caption, sub = {} } = Astro.props;
const n = backbone.length;
// Horizontal geometry
const W = 1200, H = 260, boxW = 200, gap = (W - n * boxW) / (n - 1), boxY = 60, boxH = 120;
// Vertical geometry
const VW = 360, vBoxH = 118, vGap = 34, VH = n * vBoxH + (n - 1) * vGap + 20;
const desc = `Diagram: ${backbone.map((s) => s.title).join(' → ')}.`;
---
<figure class={className}>
  <svg class="hidden w-full md:block" viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="arch-h-title arch-h-desc">
    <title id="arch-h-title">GEPER system architecture</title>
    <desc id="arch-h-desc">{desc}</desc>
    <defs>
      <marker id="arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
        <path d="M0 1 L9 5 L0 9" fill="none" stroke="var(--color-accent)" stroke-width="1.5" />
      </marker>
      <pattern id="grid-h" width="24" height="24" patternUnits="userSpaceOnUse">
        <path d="M24 0H0V24" fill="none" stroke="var(--color-line-faint)" stroke-width="1" />
      </pattern>
    </defs>
    <rect width={W} height={H} fill="url(#grid-h)" />
    {backbone.map((s, i) => {
      const x = i * (boxW + gap);
      return (
        <g>
          <rect x={x} y={boxY} width={boxW} height={boxH} rx="4" fill="var(--color-surface)" stroke="var(--color-line-strong)" />
          <rect x={x} y={boxY} width={boxW} height="2" fill="var(--color-accent)" />
          <text x={x + 16} y={boxY + 30} font-family="var(--font-mono)" font-size="11" letter-spacing="1.5" fill="var(--color-ink-muted)">{s.index}</text>
          <text x={x + 16} y={boxY + 60} font-family="var(--font-sans)" font-size="17" font-weight="600" fill="var(--color-ink)">{s.title.length > 22 ? s.short : s.title}</text>
          {(sub[s.id] ?? []).slice(0, 2).map((t, j) => (
            <text x={x + 16} y={boxY + 86 + j * 18} font-family="var(--font-mono)" font-size="11" fill="var(--color-ink-2)">{t}</text>
          ))}
          {i < n - 1 && (
            <line x1={x + boxW + 6} y1={boxY + boxH / 2} x2={x + boxW + gap - 6} y2={boxY + boxH / 2} stroke="var(--color-accent)" stroke-width="1.5" marker-end="url(#arr)" />
          )}
        </g>
      );
    })}
    <text x="0" y={H - 12} font-family="var(--font-mono)" font-size="11" letter-spacing="1.5" fill="var(--color-ink-muted)">BIOLOGICAL DATA</text>
    <text x={W} y={H - 12} text-anchor="end" font-family="var(--font-mono)" font-size="11" letter-spacing="1.5" fill="var(--color-ink-muted)">INTERPRETATION</text>
  </svg>

  <svg class="w-full md:hidden" viewBox={`0 0 ${VW} ${VH}`} role="img" aria-labelledby="arch-v-title arch-v-desc">
    <title id="arch-v-title">GEPER system architecture</title>
    <desc id="arch-v-desc">{desc}</desc>
    <defs>
      <marker id="arr-v" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
        <path d="M0 1 L9 5 L0 9" fill="none" stroke="var(--color-accent)" stroke-width="1.5" />
      </marker>
    </defs>
    {backbone.map((s, i) => {
      const y = 10 + i * (vBoxH + vGap);
      return (
        <g>
          <rect x="1" y={y} width={VW - 2} height={vBoxH} rx="4" fill="var(--color-surface)" stroke="var(--color-line-strong)" />
          <rect x="1" y={y} width="2" height={vBoxH} fill="var(--color-accent)" />
          <text x="18" y={y + 26} font-family="var(--font-mono)" font-size="11" letter-spacing="1.5" fill="var(--color-ink-muted)">{s.index}</text>
          <text x="18" y={y + 54} font-family="var(--font-sans)" font-size="17" font-weight="600" fill="var(--color-ink)">{s.title}</text>
          {(sub[s.id] ?? []).slice(0, 2).map((t, j) => (
            <text x="18" y={y + 80 + j * 18} font-family="var(--font-mono)" font-size="11" fill="var(--color-ink-2)">{t}</text>
          ))}
          {i < n - 1 && (
            <line x1={VW / 2} y1={y + vBoxH + 4} x2={VW / 2} y2={y + vBoxH + vGap - 6} stroke="var(--color-accent)" stroke-width="1.5" marker-end="url(#arr-v)" />
          )}
        </g>
      );
    })}
  </svg>
  {caption && <figcaption class="label mt-4 text-ink-muted">{caption}</figcaption>}
</figure>

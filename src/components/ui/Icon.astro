---
/** Small inline SVG icon set. Replaces the Material Symbols font (≈1 MB) from the export. */
type Name = 'arrow-right' | 'arrow-up-right' | 'menu' | 'close' | 'mail' | 'pin' | 'check' | 'alert' | 'external' | 'dna' | 'user' | 'instagram' | 'linkedin';
interface Props { name: Name; class?: string; size?: number }
const { name, class: className = '', size = 18 } = Astro.props;
const paths: Record<Name, string> = {
  'arrow-right': '<path d="M5 12h14M13 6l6 6-6 6"/>',
  'arrow-up-right': '<path d="M7 17 17 7M8 7h9v9"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
  pin: '<path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11Z"/><circle cx="12" cy="10" r="2.5"/>',
  check: '<path d="m5 12 4 4L19 6"/>',
  alert: '<path d="M12 8v5M12 16.5v.5"/><path d="M10.3 3.9 2.6 17.2A2 2 0 0 0 4.3 20h15.4a2 2 0 0 0 1.7-2.8L13.7 3.9a2 2 0 0 0-3.4 0Z"/>',
  external: '<path d="M14 4h6v6M20 4l-9 9M18 13v6a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h6"/>',
  dna: '<path d="M7 3c0 4 10 4 10 8s-10 4-10 8M17 3c0 4-10 4-10 8s10 4 10 8M8 7h8M8 15h8"/>',
  user: '<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>',
  /* Both marks are drawn in this set's own outline style — same 24 grid, same
     1.75 stroke — rather than pasted from a brand kit, so they sit with the
     rest of the icons instead of reading as foreign logos. */
  instagram: '<rect x="3.5" y="3.5" width="17" height="17" rx="4.5"/><circle cx="12" cy="12" r="3.8"/><path d="M16.9 7.1v.01"/>',
  linkedin: '<rect x="3.5" y="3.5" width="17" height="17" rx="2.5"/><path d="M7.6 10.4v6.1M7.6 7.6v.01M11.4 16.5v-6.1M11.4 12.9a2.5 2.5 0 0 1 5 0v3.6"/>',
};
---
<svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class={className} set:html={paths[name]} />

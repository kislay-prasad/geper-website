---
/** Honest empty state for sections whose factual content has not been provided yet. */
interface Props { title: string; body: string; class?: string }
const { title, body, class: className = '' } = Astro.props;
---
<div class={`rounded-lg border border-dashed border-line-strong p-6 ${className}`}>
  <p class="label text-ink-muted mb-2">Nothing listed yet</p>
  <p class="text-ink font-medium">{title}</p>
  <p class="text-body-sm text-ink-2 mt-1">{body}</p>
</div>

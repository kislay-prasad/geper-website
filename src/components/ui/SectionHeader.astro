---
import Eyebrow from './Eyebrow.astro';
interface Props { eyebrow?: string; index?: string; title: string; lead?: string; level?: 'h1' | 'h2'; align?: 'left' | 'center'; class?: string }
const { eyebrow, index, title, lead, level = 'h2', align = 'left', class: className = '' } = Astro.props;
const Tag = level;
const size = level === 'h1' ? 'text-h1' : 'text-h2';
---
<div class={`flex flex-col gap-3 ${align === 'center' ? 'items-center text-center' : ''} ${className}`}>
  {eyebrow && <Eyebrow index={index}>{eyebrow}</Eyebrow>}
  <Tag class={`${size} text-ink max-w-3xl`}>{title}</Tag>
  {lead && <p class="text-body-lg text-ink-2 max-w-prose">{lead}</p>}
</div>

---
import '@/styles/global.css';
import Header from '@/components/nav/Header.astro';
import Footer from '@/components/nav/Footer.astro';
import { site, socials, pagePath } from '@/data/site';
interface Props { title: string; description?: string; noindex?: boolean }
const { title, description = site.description, noindex = false } = Astro.props;
const fullTitle = title === site.name ? `${site.name} — ${site.tagline}` : `${title} — ${site.name}`;
const path = pagePath(Astro.url.pathname);
/* The 404 page is served at every unknown URL, so it must not claim a canonical one. */
const isNotFound = path === '/404';
const canonical = new URL(path, site.url).toString();
const ogImage = new URL(site.ogImage, site.url).toString();
/* Structured data for search engines, on the home page only. No address: GEPER is
   presented without a geographic location. */
const jsonLd = path === '/'
  ? JSON.stringify([
      {
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: site.name,
        legalName: site.legalName,
        url: site.url,
        logo: new URL('/brand/geper-mark-320.png', site.url).toString(),
        email: site.contactEmail,
        description: site.description,
        sameAs: socials.map((s) => s.href),
      },
      { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: site.url },
    ]).replace(/</g, '\\u003c')
  : '';
---
<!doctype html>
<html lang="en-GB" class="scroll-pt-20">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {!isNotFound && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#f6f3ec" data-theme-color />
    <!-- Theme, resolved before first paint so a dark visitor never sees a
         cream flash. Opt-in only: no saved choice means light, regardless of
         the OS setting. Inline and synchronous by necessity — deferring this
         is what causes the flash. -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('geper-theme');
          if (t === 'dark' || t === 'light') {
            document.documentElement.setAttribute('data-theme', t);
            var m = document.querySelector('meta[data-theme-color]');
            if (m) m.setAttribute('content', t === 'dark' ? '#16151a' : '#f6f3ec');
          }
        } catch (e) {
          /* Private mode or storage disabled: fall through to light. */
        }
      })();
    </script>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon.png" sizes="64x64" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {!isNotFound && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={site.ogImageAlt} />
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
    {site.analyticsSrc && <script is:inline async src={site.analyticsSrc}></script>}
  </head>
  <body class="min-h-dvh flex flex-col">
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main" class="flex-1 pt-16 lg:pt-[4.5rem]" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { home, research } from '@/data/content';
import { site } from '@/data/site';
import Button from '@/components/ui/Button.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import DnaNarrative from '@/components/hero/DnaNarrative.astro';
import Section from '@/components/sections/Section.astro';
import NextStep from '@/components/sections/NextStep.astro';
---
<BaseLayout title={site.name}>
  <!-- Hero -->
  <section class="relative overflow-hidden" aria-labelledby="hero-title">
    <div class="hero-grid pointer-events-none absolute inset-0 pattern-grid pattern-fade-y opacity-60" aria-hidden="true"></div>
    <div class="container-page relative flex items-center justify-center py-12 md:py-16 lg:py-20">
      <div class="flex max-w-5xl flex-col items-start gap-5 text-left">
        <h1 id="hero-title" class="max-w-[18ch] text-display text-ink md:max-w-[20ch] lg:max-w-[19ch]">Building the Future of <span class="text-accent">Genomic Intelligence.</span></h1>
        <p class="max-w-[58rem] text-body-lg text-ink-2">{home.explanation}</p>
      </div>
    </div>
  </section>

  <!-- Scroll narrative -->
  <DnaNarrative />

  <!-- Research directions -->
  <Section labelledby="research-title">
    <div class="mb-5 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
      <div>
        <Eyebrow>Research</Eyebrow>
        <h2 id="research-title" class="mt-3 text-h2 text-ink">Four research directions.</h2>
      </div>
      <Button href="/research" variant="text" icon="arrow-right">All research</Button>
    </div>

    <div class="research-streams">
      {research.pillars.map((p, index) => (
        <article class="research-item" data-index={index}>
          <div class="research-item__text">
            <span class="label text-accent-text">{p.index}</span>
            <h3 class="mt-3 text-h3 text-ink">{p.title}</h3>
            <p class="mt-3 text-body-sm text-ink-2">{p.question}</p>
            <p class="mt-3 text-body-sm text-ink-muted">{p.body}</p>
          </div>

          <div class="research-item__art" aria-hidden="true">
            {index === 0 && (
              <svg class="research-visual genomic-visual" viewBox="0 0 320 170" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Genomic pattern with missing information reconstructed from surrounding context">
                <g class="genomic-scene">
                  <g class="genomic-pattern">
                    {Array.from({ length: 30 }, (_, itemIndex) => {
                      const bases = ['A', 'T', 'C', 'G'];
                      const colors = {
                        A: '#7c94d0',
                        T: '#ca7b74',
                        C: '#b8a962',
                        G: '#6f8d67',
                      };

                      const row = Math.floor(itemIndex / 6);
                      const col = itemIndex % 6;
                      const x = 28 + col * 15;
                      const y = 30 + row * 18;
                      const isMissing = itemIndex >= 10 && itemIndex <= 15;

                      return (
                        <g class="genomic-cell" transform={`translate(${x} ${y})`}>
                          {!isMissing && (
                            <>
                              <rect class="genomic-block" x="-7.5" y="-6" width="15" height="12" rx="3" />
                              <circle class="genomic-core" r="2.7" fill={colors[bases[itemIndex % 4] as keyof typeof colors]} />
                            </>
                          )}
                          {isMissing && <rect class="genomic-gap" x="-7.5" y="-6" width="15" height="12" rx="3" />}
                        </g>
                      );
                    })}
                  </g>

                  <g class="genomic-context">
                    <path id="genomic-left" class="genomic-context-path" d="M 72 64 C 96 54, 118 54, 142 64" />
                    <path id="genomic-right" class="genomic-context-path" d="M 178 64 C 204 54, 226 54, 248 64" />
                    <path id="genomic-top" class="genomic-context-path" d="M 142 48 C 156 40, 166 40, 178 48" />
                    <path id="genomic-bottom" class="genomic-context-path" d="M 142 80 C 156 88, 166 88, 178 80" />

                    <circle class="genomic-signal genomic-signal--left" r="2.9" fill="#89a7d8">
                      <animateMotion dur="4.6s" repeatCount="indefinite" rotate="auto">
                        <mpath href="#genomic-left" />
                      </animateMotion>
                    </circle>
                    <circle class="genomic-signal genomic-signal--right" r="2.9" fill="#d29f9a">
                      <animateMotion dur="4.6s" begin="-1.2s" repeatCount="indefinite" rotate="auto">
                        <mpath href="#genomic-right" />
                      </animateMotion>
                    </circle>
                    <circle class="genomic-signal genomic-signal--top" r="2.9" fill="#b8af73">
                      <animateMotion dur="4.6s" begin="-2.1s" repeatCount="indefinite" rotate="auto">
                        <mpath href="#genomic-top" />
                      </animateMotion>
                    </circle>
                    <circle class="genomic-signal genomic-signal--bottom" r="2.9" fill="#7d9b70">
                      <animateMotion dur="4.6s" begin="-3.1s" repeatCount="indefinite" rotate="auto">
                        <mpath href="#genomic-bottom" />
                      </animateMotion>
                    </circle>
                  </g>

                  <g class="genomic-rebuild">
                    {Array.from({ length: 6 }, (_, itemIndex) => {
                      const x = 120 + itemIndex * 13;
                      const y = 46 + (itemIndex % 3) * 14;
                      return (
                        <g class="genomic-rebuild-cell" transform={`translate(${x} ${y})`}>
                          <rect class="genomic-rebuild-block" x="-7.5" y="-6" width="15" height="12" rx="3" />
                          <circle r="2.7" fill={['#7c94d0', '#ca7b74', '#b8a962', '#6f8d67'][itemIndex % 4]} />
                        </g>
                      );
                    })}
                  </g>
                </g>
              </svg>
            )}

            {index === 1 && (
              <svg class="research-visual multimodal-visual" viewBox="0 0 320 170" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Biological data streams converging into a central model">
                <g class="multimodal-streams">
                  <path class="stream-path stream-path--a" d="M18 30 C 72 30, 90 48, 118 76 S 182 110, 300 92" />
                  <path class="stream-path stream-path--b" d="M18 140 C 82 140, 98 112, 126 86 S 186 60, 300 78" />
                  <path class="stream-path stream-path--c" d="M86 18 C 104 40, 116 60, 146 82 S 188 110, 236 150" />
                  <path class="stream-path stream-path--d" d="M234 18 C 210 42, 192 62, 146 82 S 138 108, 88 150" />
                </g>

                <g class="multimodal-core">
                  <rect class="model-shell" x="122" y="62" width="76" height="42" rx="12" />
                  <path class="model-lines" d="M138 75 H180 M138 92 H180 M154 68 V102 M168 68 V102" />
                </g>
              </svg>
            )}

            {index === 2 && (
              <svg class="research-visual variant-visual" viewBox="0 0 320 170" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Variant interpretation from sequence to evidence to interpretation">
                <g class="variant-sequence">
                  <path class="reference-line" d="M28 84 H294" />
                  <circle class="reference-base base--a" cx="58" cy="84" r="4.5" />
                  <circle class="reference-base base--t" cx="98" cy="84" r="4.5" />
                  <circle class="reference-base base--c" cx="138" cy="84" r="4.5" />
                  <circle class="reference-base base--g" cx="178" cy="84" r="4.5" />
                  <circle class="reference-base base--a" cx="218" cy="84" r="4.5" />
                  <circle class="reference-base base--t" cx="258" cy="84" r="4.5" />
                </g>

                <g class="variant-layer">
                  <circle class="variant-bubble" cx="94" cy="84" r="7" />
                  <circle class="variant-bubble" cx="170" cy="84" r="7" />
                  <circle class="variant-bubble" cx="242" cy="84" r="7" />
                </g>

                <g class="evidence-links">
                  <path class="evidence-path evidence-path--1" d="M94 84 C 118 68, 130 62, 146 62" />
                  <path class="evidence-path evidence-path--2" d="M170 84 C 190 100, 194 110, 214 110" />
                  <path class="evidence-path evidence-path--3" d="M242 84 C 260 70, 250 52, 246 46" />
                </g>

                <g class="interpretation-layer">
                  <rect class="interpretation-panel" x="196" y="36" width="76" height="42" rx="10" />
                  <path class="panel-lines" d="M214 48 H246 M214 60 H246 M214 72 H236" />
                  <circle class="evidence-node evidence-node--1" cx="146" cy="62" r="5.5" />
                  <circle class="evidence-node evidence-node--2" cx="214" cy="110" r="5.5" />
                  <circle class="evidence-node evidence-node--3" cx="246" cy="46" r="5.5" />
                </g>
              </svg>
            )}

            {index === 3 && (
              <svg class="research-visual predictive-visual" viewBox="0 0 320 170" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Predictive biological network with signal propagation">
                <g class="predictive-network">
                  <path class="predictive-link predictive-link--1" d="M30 28 L 80 68 L 126 46 L 170 78 L 220 56 L 290 42" />
                  <path class="predictive-link predictive-link--2" d="M30 142 L 80 102 L 126 124 L 170 92 L 220 118 L 290 132" />
                  <path class="predictive-link predictive-link--3" d="M80 68 L 80 102" />
                  <path class="predictive-link predictive-link--4" d="M126 46 L 126 124" />
                  <path class="predictive-link predictive-link--5" d="M170 78 L 170 92" />
                  <path class="predictive-link predictive-link--6" d="M220 56 L 220 118" />
                </g>

                <g class="predictive-nodes">
                  <circle class="network-node node--1" cx="30" cy="28" r="4.6" />
                  <circle class="network-node node--2" cx="80" cy="68" r="4.6" />
                  <circle class="network-node node--3" cx="126" cy="46" r="4.6" />
                  <circle class="network-node node--4" cx="170" cy="78" r="4.6" />
                  <circle class="network-node node--5" cx="220" cy="56" r="4.6" />
                  <circle class="network-node node--6" cx="290" cy="42" r="4.6" />
                  <circle class="network-node node--7" cx="30" cy="142" r="4.6" />
                  <circle class="network-node node--8" cx="80" cy="102" r="4.6" />
                  <circle class="network-node node--9" cx="126" cy="124" r="4.6" />
                  <circle class="network-node node--10" cx="170" cy="92" r="4.6" />
                  <circle class="network-node node--11" cx="220" cy="118" r="4.6" />
                  <circle class="network-node node--12" cx="290" cy="132" r="4.6" />
                  <circle class="signal-core" cx="156" cy="84" r="15" />
                </g>

                <path class="prediction-flow" d="M104 84 C 126 66, 142 66, 158 84 S 198 102, 234 92" />
              </svg>
            )}
          </div>
        </article>
      ))}
    </div>
  </Section>

  <script type="module">
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    const researchItems = Array.from(document.querySelectorAll<HTMLElement>('.research-item'));

    if (researchItems.length) {
      const update = () => {
        const viewport = window.innerHeight;
        researchItems.forEach((item) => {
          const rect = item.getBoundingClientRect();
          const inView = (viewport - rect.top) / (rect.height + viewport * 0.4);
          const active = inView > 0.15;
          item.classList.toggle('is-active', active);
          // Only the decorative figure fades with scroll; the text always keeps full contrast.
          const art = item.querySelector<HTMLElement>('.research-item__art');
          if (art) art.style.opacity = String(Math.max(0.65, Math.min(1, 0.65 + inView * 0.35)));
        });
      };

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            entry.target.classList.toggle('is-visible', entry.isIntersecting);
          });
        },
        { threshold: [0.2, 0.55], rootMargin: '0px 0px -8% 0px' }
      );

      researchItems.forEach((item) => {
        observer.observe(item);
      });

      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
      update();
    }

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    if (!reducedMotion.matches) {
      const genomicItem = document.querySelector<HTMLElement>('.research-item[data-index="0"]');
      const multimodalItem = document.querySelector<HTMLElement>('.research-item[data-index="1"]');
      const variantItem = document.querySelector<HTMLElement>('.research-item[data-index="2"]');
      const predictiveItem = document.querySelector<HTMLElement>('.research-item[data-index="3"]');

      if (genomicItem) {
        const scene = genomicItem.querySelector('.genomic-scene');
        const patternBlocks = genomicItem.querySelectorAll('.genomic-block');
        const gapBlocks = genomicItem.querySelectorAll('.genomic-gap');
        const rebuildCells = genomicItem.querySelectorAll('.genomic-rebuild-cell');
        const signals = genomicItem.querySelectorAll('.genomic-signal');

        if (scene) {
          gsap.set(scene, {
            opacity: 0,
            x: -12,
            y: 10
          });

          gsap.to(scene, {
            opacity: 1,
            x: 0,
            y: 0,
            duration: 1.15,
            ease: 'power2.out',
            scrollTrigger: {
              trigger: genomicItem,
              start: 'top 82%',
              once: true
            }
          });
        }

        if (patternBlocks.length || gapBlocks.length || rebuildCells.length) {
          gsap.set(gapBlocks, { opacity: 0.95 });
          gsap.set(rebuildCells, { opacity: 0, scale: 0.75 });
          gsap.set(signals, { opacity: 0.2 });

          gsap.to(patternBlocks, {
            y: 1,
            duration: 2.7,
            ease: 'sine.inOut',
            repeat: -1,
            yoyo: true,
            stagger: 0.05
          });

          gsap.timeline({ repeat: -1, repeatDelay: 1.4 })
            .to(gapBlocks, { opacity: 1, duration: 0.8, ease: 'sine.inOut' }, 0.8)
            .to(signals, { opacity: 1, duration: 1.2, ease: 'sine.inOut', stagger: 0.18 }, 1.1)
            .to(rebuildCells, { opacity: 1, scale: 1, duration: 1.5, ease: 'power2.out', stagger: 0.12 }, 2.0)
            .to(gapBlocks, { opacity: 0.15, duration: 1.1, ease: 'sine.inOut' }, 3.6)
            .to(rebuildCells, { opacity: 0.95, duration: 1.1, ease: 'sine.out' }, 4.2)
            .to(signals, { opacity: 0.25, duration: 0.8, ease: 'sine.inOut' }, 4.8);
        }
      }

      if (multimodalItem) {
        const streams = multimodalItem.querySelectorAll<SVGPathElement>('.stream-path');
        const shell = multimodalItem.querySelector('.model-shell');

        if (streams.length && shell) {
          gsap.to(streams, {
            strokeDashoffset: -68,
            duration: 3.6,
            ease: 'none',
            repeat: -1
          });

          gsap.to(shell, {
            scale: 1.04,
            duration: 2.8,
            ease: 'sine.inOut',
            repeat: -1,
            yoyo: true
          });
        }
      }

      if (variantItem) {
        const evidencePaths = variantItem.querySelectorAll<SVGPathElement>('.evidence-path');
        const bubbles = variantItem.querySelectorAll<SVGCircleElement>('.variant-bubble');
        const panel = variantItem.querySelector('.interpretation-panel');

        if (evidencePaths.length && bubbles.length && panel) {
          gsap.fromTo(bubbles, { scale: 0.8, opacity: 0.72 }, {
            scale: 1.12,
            opacity: 1,
            duration: 1.6,
            ease: 'sine.inOut',
            repeat: -1,
            yoyo: true,
            stagger: 0.16
          });

          gsap.to(evidencePaths, {
            strokeDashoffset: -42,
            duration: 3.2,
            ease: 'none',
            repeat: -1
          });

          gsap.to(panel, {
            scale: 1.02,
            duration: 2.6,
            ease: 'sine.inOut',
            repeat: -1,
            yoyo: true
          });
        }
      }

      if (predictiveItem) {
        const links = predictiveItem.querySelectorAll<SVGPathElement>('.predictive-link');
        const flow = predictiveItem.querySelector('.prediction-flow');
        const core = predictiveItem.querySelector('.signal-core');

        if (links.length && flow && core) {
          gsap.to(links, {
            strokeDashoffset: -54,
            duration: 4,
            ease: 'none',
            repeat: -1
          });

          gsap.to(flow, {
            strokeDashoffset: -76,
            duration: 3.2,
            ease: 'none',
            repeat: -1
          });

          gsap.to(core, {
            scale: 1.12,
            duration: 2.2,
            ease: 'sine.inOut',
            repeat: -1,
            yoyo: true
          });
        }
      }

      researchItems.forEach((item) => {
        ScrollTrigger.create({
          trigger: item,
          start: 'top 78%',
          end: 'bottom 18%',
          scrub: 1,
          onUpdate: (self) => {
            const offset = (self.progress - 0.5) * 10;
            const art = item.querySelector('.research-visual');
            if (art) {
              gsap.to(art, { y: offset, overwrite: true, duration: 0.18, ease: 'sine.out' });
            }
          }
        });
      });
    }
  </script>

  <style>
    /* The hero grid is layered at 60% opacity, which left the shared
       .pattern-grid value barely visible behind the headline. Darkened here
       only; the site-wide grid token is untouched. */
    .hero-grid.pattern-grid {
      background-image:
        linear-gradient(to right, rgb(var(--grid-ink) / 0.28) 1px, transparent 1px),
        linear-gradient(to bottom, rgb(var(--grid-ink) / 0.28) 1px, transparent 1px);
    }

    .research-streams {
      display: grid;
      gap: 0.25rem;
      margin-top: 0.75rem;
    }

    .research-item {
      display: grid;
      grid-template-columns: minmax(0, 1.12fr) minmax(240px, 0.88fr);
      gap: 1.1rem;
      align-items: center;
      padding: 0.7rem 0;
      border-top: 1px solid rgb(69 70 77 / 0.25);
      transition: transform 220ms ease;
    }

    .research-item.is-active {
      transform: translateY(-1px);
    }

    .research-item__text {
      min-width: 0;
    }

    /* Each figure sits on its own raised cream panel, so an animation reads as
       a framed exhibit rather than as marks floating on the page. */
    .research-item__art {
      width: 100%;
      min-height: 11.4rem;
      opacity: 0.82;
      transition: opacity 220ms ease, border-color 220ms ease;
      display: flex;
      align-items: center;
      justify-content: center;
      /* Panel keeps its own grid: background-color and background-image are set
         separately because the `background` shorthand would clear the grid. */
      background-color: var(--color-bg-raised);
      background-image:
        linear-gradient(to right, rgb(var(--grid-ink) / 0.16) 1px, transparent 1px),
        linear-gradient(to bottom, rgb(var(--grid-ink) / 0.16) 1px, transparent 1px);
      background-size: 48px 48px;
      border: 1px solid var(--color-line-faint);
      border-radius: var(--radius-lg);
      padding: 0.75rem 0.9rem;
    }

    .research-item.is-active .research-item__art {
      opacity: 1;
      border-color: var(--color-line);
    }

    .research-item__art svg {
      display: block;
      width: 100%;
      max-width: 24rem;
      height: 10.8rem;
      overflow: visible;
    }

    .research-visual {
      filter: drop-shadow(0 0 12px rgba(59, 130, 246, 0.04));
    }

    .genomic-helix,
    .multimodal-streams,
    .multimodal-core,
    .variant-sequence,
    .variant-layer,
    .evidence-links,
    .interpretation-layer,
    .predictive-network,
    .predictive-nodes {
      transform-box: fill-box;
      transform-origin: center;
    }

    .dna-strand,
    .dna-pair,
    .stream-path,
    .reference-line,
    .evidence-path,
    .predictive-link,
    .prediction-flow,
    .model-lines,
    .panel-lines {
      fill: none;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .genomic-visual {
      overflow: visible;
    }

    .genomic-scene {
      transform-box: fill-box;
      transform-origin: center;
      will-change: transform, opacity;
      transform: scale(1.08) translateY(1px);
    }

    .genomic-pattern,
    .genomic-context,
    .genomic-rebuild {
      transform-box: fill-box;
      transform-origin: center;
    }

    .genomic-block,
    .genomic-gap,
    .genomic-rebuild-block {
      fill: rgba(18, 25, 38, 0.76);
      stroke: rgba(153, 169, 195, 0.28);
      stroke-width: 0.8;
    }

    .genomic-core {
      stroke: rgba(142, 160, 190, 0.18);
      stroke-width: 0.35;
    }

    .genomic-gap {
      fill: rgba(12, 17, 24, 0.9);
      stroke: rgba(176, 186, 204, 0.22);
      stroke-dasharray: 2 4;
    }

    .genomic-context-path {
      fill: none;
      stroke: rgba(163, 177, 204, 0.38);
      stroke-width: 1.1;
      stroke-dasharray: 4 8;
    }

    .genomic-signal,
    .genomic-flow-signal {
      opacity: 0.2;
    }

    .genomic-rebuild-block {
      fill: rgba(18, 25, 38, 0.82);
      stroke: rgba(148, 166, 200, 0.26);
    }

    /* ---------------------------------------------------------------
       Dark-theme corrections.

       These four figures predate the token system and paint from literal
       values, so they cannot follow the theme on their own. Two of them break
       on a dark ground and are corrected here; the other two already read
       correctly and are deliberately left alone. Light mode is untouched —
       every rule below is gated on the root theme attribute.

       01 · the cells are near-black plates that vanish on charcoal, so they
       are lifted to a pale wash. The gap keeps reading as absence by being
       DARKER than its neighbours, exactly as it is darker on cream.
       04 · the network was tuned to warm charcoal for the cream ground; on a
       dark ground the same marks disappear, so the neutrals invert while the
       green core and flow keep their meaning.
       --------------------------------------------------------------- */
    :global(:root[data-theme="dark"]) .genomic-block,
    :global(:root[data-theme="dark"]) .genomic-rebuild-block {
      fill: rgba(232, 236, 244, 0.1);
      stroke: rgba(186, 198, 219, 0.34);
    }
    :global(:root[data-theme="dark"]) .genomic-gap {
      fill: rgba(0, 0, 0, 0.32);
      stroke: rgba(196, 206, 224, 0.3);
    }
    :global(:root[data-theme="dark"]) .genomic-core {
      stroke: rgba(226, 232, 240, 0.24);
    }

    :global(:root[data-theme="dark"]) .predictive-link {
      stroke: rgba(226, 230, 238, 0.34);
    }
    :global(:root[data-theme="dark"]) .network-node {
      fill: rgba(226, 230, 238, 0.82);
      stroke: rgba(226, 230, 238, 0.4);
    }
    :global(:root[data-theme="dark"]) .signal-core {
      fill: rgba(69, 207, 149, 0.22);
      stroke: rgba(69, 207, 149, 0.95);
    }
    :global(:root[data-theme="dark"]) .prediction-flow {
      stroke: rgba(69, 207, 149, 0.9);
    }

    .stream-path {
      stroke-width: 1.5;
      stroke-dasharray: 10 12;
    }

    .stream-path--a { stroke: rgba(59, 130, 246, 0.72); }
    .stream-path--b { stroke: rgba(34, 197, 94, 0.72); }
    .stream-path--c { stroke: rgba(250, 204, 21, 0.72); }
    .stream-path--d { stroke: rgba(239, 68, 68, 0.72); }

    .model-shell {
      fill: rgba(15, 23, 42, 0.65);
      stroke: rgba(96, 165, 250, 0.45);
      stroke-width: 1.1;
    }

    .model-lines {
      stroke: rgba(148, 163, 184, 0.45);
      stroke-width: 1.2;
    }

    .reference-line {
      stroke: rgba(148, 163, 184, 0.38);
      stroke-width: 1.5;
    }

    .reference-base {
      opacity: 0.95;
    }

    .base--a { fill: #3b82f6; }
    .base--t { fill: #ef4444; }
    .base--c { fill: #facc15; }
    .base--g { fill: #22c55e; }

    .variant-bubble {

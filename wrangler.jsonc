{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "geper-website",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-11",
  "vars": {
    "CONTACT_FROM": "GEPER Website <website@notify.geper.in>",
    "CONTACT_TO": "contact@geper.in"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // Workers Logs: keeps console output and errors from /api/* so failures can be diagnosed.
  "observability": {
    "enabled": true
  }
}
